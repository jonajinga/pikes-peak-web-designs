<script>
  (function () {
    var els = {
      visits:   document.getElementById('calc-visits'),
      mobile:   document.getElementById('calc-mobileShare'),
      mobileO:  document.getElementById('calc-mobileShare-out'),
      ps:       document.getElementById('calc-pagespeed'),
      psO:      document.getElementById('calc-pagespeed-out'),
      conv:     document.getElementById('calc-conv'),
      convO:    document.getElementById('calc-conv-out'),
      job:      document.getElementById('calc-job'),
      close:    document.getElementById('calc-close'),
      closeO:   document.getElementById('calc-close-out'),
      outRev:   document.getElementById('calc-out-revenue'),
      outLost:  document.getElementById('calc-out-lost'),
      outLeads: document.getElementById('calc-out-leads'),
      outJobs:  document.getElementById('calc-out-jobs'),
    };
    if (!els.visits) return;

    function fmt(n) {
      if (!isFinite(n)) return '$—';
      return '$' + Math.round(n).toLocaleString('en-US');
    }
    function fmtNum(n) {
      if (!isFinite(n)) return '—';
      return Math.round(n).toLocaleString('en-US');
    }

    function update() {
      var visits = parseFloat(els.visits.value) || 0;
      var mobileShare = parseFloat(els.mobile.value) / 100;
      var pagespeed = parseFloat(els.ps.value);
      var convRate = parseFloat(els.conv.value) / 100;
      var job = parseFloat(els.job.value) || 0;
      var closeRate = parseFloat(els.close.value) / 100;

      els.mobileO.textContent = (mobileShare * 100).toFixed(0) + '%';
      els.psO.textContent = pagespeed.toFixed(0);
      els.convO.textContent = convRate.toFixed(1).replace(/\.0$/, '') + (convRate < 1 ? '%' : '%');
      els.convO.textContent = (convRate * 100).toFixed(1).replace(/\.0$/, '') + '%';
      els.closeO.textContent = (closeRate * 100).toFixed(0) + '%';

      // Each PageSpeed point below 95 = ~1.5% additional mobile bounce.
      // Cap the loss multiplier at 60% so the math doesn't run away.
      var psGap = Math.max(0, 95 - pagespeed);
      var bounceUplift = Math.min(0.6, psGap * 0.015);
      var mobileVisits = visits * mobileShare;
      var lostMonthly = mobileVisits * bounceUplift;
      var leadsAnnually = lostMonthly * 12 * convRate;
      var jobsAnnually = leadsAnnually * closeRate;
      var revenueAnnually = jobsAnnually * job;

      els.outRev.textContent = fmt(revenueAnnually);
      els.outLost.textContent = fmtNum(lostMonthly);
      els.outLeads.textContent = fmtNum(leadsAnnually);
      els.outJobs.textContent = fmtNum(jobsAnnually);
    }

    ['input', 'change'].forEach(function (evt) {
      Object.values(els).forEach(function (el) {
        if (el && el.addEventListener && (el.tagName === 'INPUT' || el.tagName === 'OUTPUT' || el.type)) {
          el.addEventListener(evt, update);
        }
      });
    });
    update();
  })();
</script>
