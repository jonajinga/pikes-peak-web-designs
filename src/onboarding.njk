---
layout: layouts/base.njk
title: "New Client Onboarding | Pikes Peak Web Designs"
description: "The detailed onboarding form for new Pikes Peak Web Designs clients. Fill this out after your discovery call; it tells us everything we need to start building."
noindex: true
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><span>Onboarding</span>
    </nav>
    <span class="section-label">New Client Onboarding</span>
    <h1>Tell us about <em>your business.</em></h1>
    <p>This form walks us through everything we need to start building. There's no rush; you can save what you have and come back, but the more detail you give us now, the faster we launch.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <div class="contact-form-card">
      <h2 style="font-family:var(--font-display);font-size:1.6rem;font-weight:700;margin-bottom:0.35rem">Onboarding details</h2>
      <p style="color:var(--text-muted);font-size:0.95rem;margin-bottom:1.75rem">All fields are optional unless marked. If you don't know something, just leave it blank and we'll follow up.</p>

      <form id="onboardingForm" data-web3forms data-redirect="/thank-you/?type=onboarding" action="https://api.web3forms.com/submit" method="POST" class="form">
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY">
        <input type="hidden" name="subject" value="New onboarding submission, Pikes Peak Web Designs">
        <input type="hidden" name="from_name" value="Pikes Peak Onboarding Form">
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

        <fieldset class="fieldset">
          <legend>1. Your business</legend>
          <div class="form-row" style="margin-top:1rem">
            <div class="form-group">
              <label for="businessName">Business name <span class="req">*</span></label>
              <input type="text" id="businessName" name="businessName" required autocomplete="organization">
            </div>
            <div class="form-group">
              <label for="dba">DBA (if different)</label>
              <input type="text" id="dba" name="dba">
            </div>
          </div>
          <div class="form-group">
            <label for="tagline">One-line description of what you do</label>
            <input type="text" id="tagline" name="tagline" placeholder="e.g. Residential plumbing and drain cleaning in Colorado Springs">
          </div>
          <div class="form-group">
            <label for="yearsInBusiness">Years in business</label>
            <input type="text" id="yearsInBusiness" name="yearsInBusiness" placeholder="e.g. 12">
          </div>
          <div class="form-group">
            <label for="teamSize">Team size</label>
            <select id="teamSize" name="teamSize">
              <option value="">Choose one…</option>
              <option>Solo / owner-operator</option>
              <option>2–5 people</option>
              <option>6–15 people</option>
              <option>16–50 people</option>
              <option>50+ people</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>2. Contact &amp; service area</legend>
          <div class="form-row" style="margin-top:1rem">
            <div class="form-group">
              <label for="primaryContact">Primary contact name <span class="req">*</span></label>
              <input type="text" id="primaryContact" name="primaryContact" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="role">Role</label>
              <input type="text" id="role" name="role" placeholder="Owner, Office Manager, etc.">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">Email <span class="req">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email">
            </div>
            <div class="form-group">
              <label for="phone">Phone <span class="req">*</span></label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel">
            </div>
          </div>
          <div class="form-group">
            <label for="physicalAddress">Physical address (or "no storefront")</label>
            <input type="text" id="physicalAddress" name="physicalAddress" placeholder="Street, city, state, ZIP">
          </div>
          <div class="form-group">
            <label for="serviceArea">Service area; list cities, counties, or miles from your base</label>
            <textarea id="serviceArea" name="serviceArea" rows="3" placeholder="e.g. Colorado Springs, Monument, Fountain, and a 45-mile radius"></textarea>
          </div>
          <div class="form-group">
            <label for="hours">Business hours</label>
            <input type="text" id="hours" name="hours" placeholder="e.g. Mon–Fri 7am–6pm, Sat by appointment">
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>3. Services &amp; offerings</legend>
          <div class="form-group" style="margin-top:1rem">
            <label for="services">List your services (one per line, most important first)</label>
            <textarea id="services" name="services" rows="6" placeholder="e.g.&#10;Emergency plumbing&#10;Drain cleaning&#10;Water heater repair &amp, install&#10;Repiping&#10;Sewer line repair"></textarea>
          </div>
          <div class="form-group">
            <label for="pricingApproach">Pricing approach</label>
            <select id="pricingApproach" name="pricingApproach">
              <option value="">Choose one…</option>
              <option>Flat rate published on site</option>
              <option>Flat rate, but not on site</option>
              <option>Free estimate, then quote</option>
              <option>Hourly / T&amp;M</option>
              <option>Varies / depends on job</option>
            </select>
          </div>
          <div class="form-group">
            <label for="specialties">Specialties or things you're known for</label>
            <textarea id="specialties" name="specialties" rows="3"></textarea>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>4. Customers &amp; goals</legend>
          <div class="form-group" style="margin-top:1rem">
            <label for="idealCustomer">Describe your ideal customer</label>
            <textarea id="idealCustomer" name="idealCustomer" rows="3" placeholder="Homeowners 35–65, 3–5 yr old home, etc."></textarea>
          </div>
          <div class="form-group">
            <label for="goals">What do you want the new site to accomplish? (pick any that apply)</label>
            <textarea id="goals" name="goals" rows="3" placeholder="e.g. More phone calls, more quote requests, show up in Google Maps, hire better employees, look credible to insurance companies"></textarea>
          </div>
          <div class="form-group">
            <label for="competitors">Three competitors whose websites you think look good</label>
            <textarea id="competitors" name="competitors" rows="3" placeholder="URLs or names"></textarea>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>5. Brand &amp; assets</legend>
          <div class="form-row" style="margin-top:1rem">
            <div class="form-group">
              <label for="hasLogo">Do you have a logo?</label>
              <select id="hasLogo" name="hasLogo">
                <option value="">Choose one…</option>
                <option>Yes, vector (SVG/AI/PDF)</option>
                <option>Yes, raster (PNG/JPG)</option>
                <option>Partial (wordmark only)</option>
                <option>No logo (we need one)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="hasPhotos">Do you have real photos of your work?</label>
              <select id="hasPhotos" name="hasPhotos">
                <option value="">Choose one…</option>
                <option>Yes, lots</option>
                <option>A few usable shots</option>
                <option>None yet (need help)</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="brandColors">Brand colors (if you have them)</label>
            <input type="text" id="brandColors" name="brandColors" placeholder="e.g. navy #0A1F44 and gold, or describe what you like">
          </div>
          <div class="form-group">
            <label for="assetsLink">Link to a shared folder with your assets (Drive, Dropbox, etc.)</label>
            <input type="url" id="assetsLink" name="assetsLink" placeholder="https://">
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>6. Current website &amp; domain</legend>
          <div class="form-group" style="margin-top:1rem">
            <label for="currentSiteUrl">Current website URL (if any)</label>
            <input type="url" id="currentSiteUrl" name="currentSiteUrl" placeholder="https://yourbusiness.com">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="domainRegistrar">Domain registrar (where you bought the domain)</label>
              <input type="text" id="domainRegistrar" name="domainRegistrar" placeholder="GoDaddy, Namecheap, Google Domains, etc.">
            </div>
            <div class="form-group">
              <label for="currentStack">What's the current site built on?</label>
              <select id="currentStack" name="currentStack">
                <option value="">Choose one…</option>
                <option>No site yet</option>
                <option>WordPress</option>
                <option>Wix / Squarespace / Weebly</option>
                <option>GoDaddy Website Builder</option>
                <option>Custom site</option>
                <option>Not sure</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="currentSiteFeelings">Three things you like, and three you don't like; about your current site</label>
            <textarea id="currentSiteFeelings" name="currentSiteFeelings" rows="4"></textarea>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>7. Google &amp; social</legend>
          <div class="form-row" style="margin-top:1rem">
            <div class="form-group">
              <label for="googleBusiness">Google Business Profile URL</label>
              <input type="url" id="googleBusiness" name="googleBusiness" placeholder="https://g.page/…">
            </div>
            <div class="form-group">
              <label for="reviewCount">Roughly how many reviews?</label>
              <input type="text" id="reviewCount" name="reviewCount" placeholder="e.g. 47">
            </div>
          </div>
          <div class="form-group">
            <label for="socialLinks">Social profiles (one per line)</label>
            <textarea id="socialLinks" name="socialLinks" rows="3" placeholder="Facebook, Instagram, LinkedIn, YouTube, Nextdoor…"></textarea>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>8. Credentials &amp; trust signals</legend>
          <div class="form-group" style="margin-top:1rem">
            <label for="credentials">Licenses, certifications, memberships</label>
            <textarea id="credentials" name="credentials" rows="3" placeholder="e.g. Colorado Master Plumber License #12345, BBB A+ Rating, Angie's List Super Service"></textarea>
          </div>
          <div class="form-group">
            <label for="awards">Awards, press, or community recognition</label>
            <textarea id="awards" name="awards" rows="2"></textarea>
          </div>
          <div class="form-group">
            <label for="testimonials">Favorite customer quotes (verbatim is best)</label>
            <textarea id="testimonials" name="testimonials" rows="4" placeholder="A few of your best reviews or testimonials, with customer first name and city if possible"></textarea>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>9. Anything else</legend>
          <div class="form-group" style="margin-top:1rem">
            <label for="openNotes">Anything else we should know?</label>
            <textarea id="openNotes" name="openNotes" rows="5" placeholder="Deadlines, seasonal timing, a specific feature you want, someone we shouldn't mention, a story you want told, anything."></textarea>
          </div>
        </fieldset>

        <div id="form-error" role="alert" class="form-error">
          Something went wrong sending your submission. Please try again, email us at <a href="mailto:{{ site.email }}">{{ site.email }}</a>, or call <a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a>.
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:1.5rem">Submit onboarding details</button>
        <p class="form-hint" style="text-align:center;margin-top:0.75rem">We treat everything you share here as confidential; see our <a href="/privacy-policy/" class="inline-link">privacy policy</a>.</p>
      </form>
    </div>

    <p style="margin-top:2rem;font-size:0.92rem;color:var(--text-muted);text-align:center">Prefer to send this some other way? Email us a Google Doc, Dropbox Paper, or Notion page at <a href="mailto:{{ site.email }}" class="inline-link">{{ site.email }}</a>.</p>
  </div>
</section>
