      <h2 class="faq-group-title">Onboarding &amp; client portal</h2>
      <div class="faq-list" style="margin-top:1.25rem">
        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">What does onboarding actually involve? <span class="faq-icon" aria-hidden="true"></span></button>
