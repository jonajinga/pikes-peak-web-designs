      <!-- Right: Form -->
      <div class="form-card">
        <h3 style="margin-bottom:6px;">Send us a message</h3>
        <p style="font-size:0.875rem;color:var(--muted);margin-bottom:28px;">Fill out the form and we'll be in touch within one business day.</p>

        <form id="contactForm" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY">
          <input type="hidden" name="redirect" value="https://pikespeakwebdesigns.com/thank-you/">
          <input type="hidden" name="subject" value="New Contact Form Submission — Pikes Peak Web Designs">
          <input type="hidden" name="from_name" value="Pikes Peak Web Designs Contact Form">
          <!-- Honeypot spam protection -->
          <input type="checkbox" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off">

          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First Name</label>
              <input type="text" id="firstName" name="firstName" placeholder="Jane" required>
            </div>
            <div class="form-group">
              <label for="lastName">Last Name</label>
              <input type="text" id="lastName" name="lastName" placeholder="Smith" required>
            </div>
          </div>

          <div class="form-group">
            <label for="businessName">Business Name</label>
            <input type="text" id="businessName" name="businessName" placeholder="Smith's Roofing Co." required>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="jane@yourbusiness.com" required>
          </div>

          <div class="form-group">
            <label for="phone">Phone Number <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted);">(optional)</span></label>
            <input type="tel" id="phone" name="phone" placeholder="(719) 555-0100">
          </div>

          <div class="form-group">
            <label for="currentSite">Do you currently have a website?</label>
            <select id="currentSite" name="currentSite">
              <option value="">Select an option...</option>
              <option value="no-site">No &mdash; I need one built from scratch</option>
              <option value="has-wordpress">Yes &mdash; it's on WordPress</option>
              <option value="has-wix">Yes &mdash; it's on Wix / Squarespace</option>
              <option value="has-custom">Yes &mdash; it's a custom site</option>
              <option value="has-other">Yes &mdash; something else</option>
            </select>
          </div>

          <div class="form-group">
            <label for="serviceNeed">What can we help with?</label>
            <select id="serviceNeed" name="serviceNeed">
              <option value="">Select an option...</option>
              <option value="new-website">New website</option>
              <option value="rebuild">Rebuild / replace existing site</option>
              <option value="not-sure">Not sure yet</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Tell us about your business and what you're looking for</label>
            <textarea id="message" name="message" placeholder="What does your business do? What's the biggest problem with your current website (or why do you need one)? Any specific goals for the new site?" required></textarea>
          </div>

          <div id="form-error" role="alert" style="display:none;" class="form-submit-error">
            Something went wrong sending your message. Please try again or email us directly at <a href="mailto:hello@pikespeakwebdesigns.com">hello@pikespeakwebdesigns.com</a>.
