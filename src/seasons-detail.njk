---
pagination:
  data: seasons
  size: 1
  alias: page
  addAllPagesToCollections: true
permalink: "/seasons/{{ page.slug }}/"
layout: layouts/base.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ page.metaTitle }}"
  description: "{{ page.metaDescription }}"
  ogImage: "/assets/img/og/seasons/{{ page.slug }}.png"
  ogImageAlt: "{{ page.h1 }} {{ page.h1Em }} | Pikes Peak Web Designs"
  noindex: false
---

<section class="page-hero page-hero--peak season-hero">
  <div class="container">
    <span class="section-label">{{ page.eyebrow }}</span>
    <h1>{{ page.h1 }} <em>{{ page.h1Em }}</em></h1>
    <p class="season-hero-lead">{{ page.heroLead | safe }}</p>
    <div class="cta-buttons" style="justify-content:center;margin-top:2rem">
      <a href="/subscribe/" class="btn btn-primary btn-lg">Start now</a>
    </div>
    <p style="margin-top:1.25rem"><a href="/contact/" class="inline-link" style="color:var(--gold-400)">Prefer to talk first? Book a free call</a> (20 to 30 minutes on Google Meet).</p>
    <p class="season-hero-meta">{{ page.season }}</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <div class="text-center">
      <span class="section-label">The case for it</span>
      <h2 class="section-title" style="margin-inline:auto">{{ page.argumentTitle }}</h2>
    </div>
    <div class="season-argument">
      {% for paragraph in page.argumentBody %}
        <p>{{ paragraph | safe }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container" style="max-width:760px">
    <div class="season-pitch">
      <span class="section-label">The short version</span>
      <h2 class="season-pitch-title">{{ page.pitchTitle }}</h2>
      <p class="season-pitch-body">{{ page.pitchBody | safe }}</p>
      <div class="cta-buttons" style="justify-content:flex-start;margin-top:0.5rem">
        <a href="/subscribe/" class="btn btn-primary btn-lg">Start now &rarr;</a>
      </div>
      <p style="margin-top:1rem"><a href="/contact/" class="inline-link">Prefer to talk first? Book a free call</a></p>
      <p class="season-pitch-foot">$175 a month, flat, with no design deposit and a 12-month minimum. The build starts when your first payment clears.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <div class="text-center">
      <span class="section-label">Common questions</span>
      <h2 class="section-title" style="margin-inline:auto">If the first thought is "but&hellip;"</h2>
    </div>
    <div class="faq-list" style="margin-top:2rem">
      {% for item in page.objections %}
        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">{{ item.q }} <span class="faq-icon" aria-hidden="true"></span></button>
          <div class="faq-answer"><div class="faq-answer-inner">{{ item.a | safe }}</div></div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <span class="section-label">Ready when you are</span>
    <h2>One flat rate, and a launch in two to three weeks</h2>
    <p>A custom-coded, fast, accessible site for $175 a month, flat. The build starts when your first payment clears.</p>
    <div class="cta-buttons">
      <a href="/subscribe/" class="btn btn-primary btn-lg">Start now</a>
    </div>
    <p style="margin-top:1.25rem"><a href="/contact/" class="inline-link" style="color:var(--gold-400)">Prefer to talk first? Book a free call</a></p>
  </div>
</section>
