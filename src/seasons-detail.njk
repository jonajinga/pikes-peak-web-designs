---
pagination:
  data: seasons
  size: 1
  alias: page
  addAllPagesToCollections: true
permalink: "/seasons/{{ page.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ page.metaTitle }}"
  description: "{{ page.metaDescription }}"
  ogImage: "{{ page.shareCard }}"
---

<section class="page-hero page-hero--peak season-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><a href="/seasons/">Seasons</a><span class="sep">/</span><span>{{ page.occasionShort }}</span>
    </nav>
    <span class="section-label">{{ page.eyebrow }}</span>
    <h1>{{ page.h1 }} <em>{{ page.h1Em }}</em></h1>
    <p class="season-hero-lead">{{ page.heroLead }}</p>
    <div class="cta-buttons" style="justify-content:center;margin-top:2rem">
      <a href="{{ page.pitchCtaUrl }}" class="btn btn-primary btn-lg">{{ page.pitchCta }}</a>
      <a href="/pricing/" class="btn btn-outline btn-lg">See the pricing</a>
    </div>
    <p class="season-hero-meta">{{ page.season }}</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <div class="text-center">
      <span class="section-label">The case for it</span>
      <h2 class="section-title" style="margin-inline:auto">{{ page.argumentTitle }}</h2>
    </div>
    <div class="season-argument">
      {% for paragraph in page.argumentBody %}
        <p>{{ paragraph }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container" style="max-width:760px">
    <div class="season-pitch">
      <span class="section-label">The pitch in one paragraph</span>
      <h2 class="season-pitch-title">{{ page.pitchTitle }}</h2>
      <p class="season-pitch-body">{{ page.pitchBody }}</p>
      <a href="{{ page.pitchCtaUrl }}" class="btn btn-primary btn-lg">{{ page.pitchCta }} &rarr;</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <div class="text-center">
      <span class="section-label">Common questions</span>
      <h2 class="section-title" style="margin-inline:auto">If the first thought is "but&hellip;"</h2>
    </div>
    <div class="faq-list" style="margin-top:2rem">
      {% for item in page.objections %}
        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">{{ item.q }} <span class="faq-icon" aria-hidden="true"></span></button>
          <div class="faq-answer"><div class="faq-answer-inner">{{ item.a }}</div></div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--mist">
  <div class="container" style="max-width:760px">
    <div class="text-center">
      <span class="section-label">Other occasions</span>
      <h2 class="section-title" style="margin-inline:auto">Year-round shareable pages.</h2>
      <p class="section-subtitle">Each one is evergreen. Same URL, every year.</p>
    </div>
    <ul class="seasons-cross">
      {% for s in seasons %}
        {% if s.slug != page.slug %}
          <li><a href="/seasons/{{ s.slug }}/" class="seasons-cross-link">
            <span class="seasons-cross-tag">{{ s.season }}</span>
            <span class="seasons-cross-title">{{ s.occasionShort }}</span>
          </a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <span class="section-label">Ready when you are</span>
    <h2>One flat rate. Two to three weeks to launch.</h2>
    <p>Whatever the occasion, the build is the same: custom-coded, fast, accessible, and yours for $175 a month flat.</p>
    <div class="cta-buttons">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a discovery call</a>
      <a href="/pricing/" class="btn btn-outline btn-lg">Read the pricing in detail</a>
    </div>
  </div>
</section>
