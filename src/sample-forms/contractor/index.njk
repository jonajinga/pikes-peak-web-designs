description: "A working sample bid-request form for general contractors. Pre-qualifies leads with scope, budget, timeline, financing, and referral source."
permalink: /sample-forms/contractor/
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><a href="/sample-forms/">Sample forms</a><span class="sep">/</span><span>Contractor bid request</span>
    </nav>
    <span class="section-label">General Contractor &middot; live working form</span>
    <h1>Bid request, <em>pre-qualified.</em></h1>
    <p>Real working form. Designed for a remodeler / GC who only wants to spend an hour on the phone with leads worth bidding. Captures scope, budget, financing, timeline, and how the homeowner is making the decision.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    <div class="contact-form-card">
      <h2 class="form-heading">Tell us about your project</h2>
      <p class="form-intro">No fluff &mdash; just the questions a good GC wants answered before scheduling a site visit.</p>

      <form data-web3forms data-redirect="/thank-you/?type=sample-contractor" action="https://api.web3forms.com/submit" method="POST" class="form">
        <input type="hidden" name="access_key" value="b6c3454b-f07c-43f7-9070-0e0cb5286f55">
        <input type="hidden" name="subject" value="[Sample Contractor] Bid request">
        <input type="hidden" name="from_name" value="Pikes Peak — Sample contractor form">
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

        <fieldset class="fieldset">
          <legend>1. About you</legend>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="phone">Best phone <span class="req">*</span></label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel">
            </div>
          </div>
          <div class="form-group">
            <label for="email">Email <span class="req">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email">
          </div>
          <div class="form-group">
            <label for="address">Project address <span class="req">*</span></label>
            <input type="text" id="address" name="address" required autocomplete="street-address">
          </div>
          <div class="form-group">
            <label id="ownershipLabel">Ownership of the property</label>
            <div class="form-radio-group" role="radiogroup" aria-labelledby="ownershipLabel">
              <label><input type="radio" name="ownership" value="own"> I own the property</label>
              <label><input type="radio" name="ownership" value="under-contract"> Under contract / closing soon</label>
              <label><input type="radio" name="ownership" value="rent"> I rent (have owner approval)</label>
              <label><input type="radio" name="ownership" value="rep"> Representing an owner / property manager</label>
            </div>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>2. The project</legend>
          <div class="form-group">
            <label for="projectType">Project type <span class="req">*</span></label>
            <select id="projectType" name="projectType" required>
              <option value="">Choose one&hellip;</option>
              <option>Kitchen remodel</option>
              <option>Bathroom remodel</option>
              <option>Whole-home remodel</option>
              <option>Addition / room add-on</option>
              <option>Basement finish</option>
              <option>Garage / ADU build</option>
              <option>Deck / outdoor structure</option>
              <option>Roof replacement</option>
              <option>Window / siding replacement</option>
              <option>New construction</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="description">Describe the project <span class="req">*</span></label>
            <textarea id="description" name="description" rows="6" required placeholder="What you're hoping to do, what you've already decided, what you're undecided on. The more you share, the better we can tailor the bid."></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="sqft">Project sq ft (approx)</label>
              <input type="text" id="sqft" name="sqft" placeholder="e.g. 240 sq ft kitchen, 1,200 sq ft addition">
            </div>
            <div class="form-group">
              <label for="floors">Floor levels involved</label>
              <select id="floors" name="floors">
                <option>Single floor / level</option>
                <option>Multi-floor</option>
                <option>Whole home</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label id="designStatusLabel">Design status</label>
            <div class="form-radio-group" role="radiogroup" aria-labelledby="designStatusLabel">
              <label><input type="radio" name="designStatus" value="have-architect"> Have architect drawings</label>
              <label><input type="radio" name="designStatus" value="have-designer"> Have designer / interior plans</label>
              <label><input type="radio" name="designStatus" value="rough-sketches"> Rough sketches / Pinterest board</label>
              <label><input type="radio" name="designStatus" value="need-design"> Need design help &mdash; bring your team</label>
              <label><input type="radio" name="designStatus" value="just-ideas"> Just ideas, want to talk it through</label>
            </div>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>3. Budget &amp; financing</legend>
          <div class="form-group">
            <label for="budget">Realistic budget range <span class="req">*</span></label>
            <select id="budget" name="budget" required>
              <option value="">Choose one&hellip;</option>
              <option>Under $25k</option>
              <option>$25k&ndash;$75k</option>
              <option>$75k&ndash;$150k</option>
              <option>$150k&ndash;$300k</option>
              <option>$300k&ndash;$500k</option>
              <option>$500k+</option>
              <option>Not sure &mdash; need guidance</option>
            </select>
          </div>
          <div class="form-group">
            <label id="financingLabel">How will you fund the project?</label>
            <div class="form-radio-group" role="radiogroup" aria-labelledby="financingLabel">
              <label><input type="radio" name="financing" value="cash"> Cash / savings</label>
              <label><input type="radio" name="financing" value="heloc"> HELOC or home-equity loan</label>
              <label><input type="radio" name="financing" value="construction"> Construction loan</label>
              <label><input type="radio" name="financing" value="insurance"> Insurance proceeds</label>
              <label><input type="radio" name="financing" value="contractor-financing"> Contractor financing</label>
              <label><input type="radio" name="financing" value="undecided"> Undecided</label>
            </div>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>4. Timeline</legend>
          <div class="form-group">
            <label id="startLabel">When do you want to start? <span class="req">*</span></label>
            <div class="form-radio-group" role="radiogroup" aria-labelledby="startLabel">
              <label><input type="radio" name="start" value="asap" required> ASAP &mdash; ready to sign</label>
              <label><input type="radio" name="start" value="1-3-months"> 1&ndash;3 months</label>
              <label><input type="radio" name="start" value="3-6-months"> 3&ndash;6 months</label>
              <label><input type="radio" name="start" value="6-12-months"> 6&ndash;12 months</label>
              <label><input type="radio" name="start" value="planning"> Just planning &mdash; no rush</label>
            </div>
          </div>
          <div class="form-group">
            <label for="deadline">Any hard deadline? (move-in, holiday, lease, etc.)</label>
            <input type="text" id="deadline" name="deadline" placeholder="e.g. baby due in March, hosting Thanksgiving, lease ends June 30">
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>5. Decision &amp; references</legend>
          <div class="form-group">
            <label id="bidsLabel">Are you getting other bids?</label>
            <div class="form-radio-group" role="radiogroup" aria-labelledby="bidsLabel">
              <label><input type="radio" name="bids" value="us-only"> No &mdash; you came recommended</label>
              <label><input type="radio" name="bids" value="2-3"> Yes, 2&ndash;3 contractors</label>
              <label><input type="radio" name="bids" value="4-plus"> Yes, 4+ contractors</label>
              <label><input type="radio" name="bids" value="open"> Open to it &mdash; you're first</label>
            </div>
          </div>
          <div class="form-group">
            <label id="decisionLabel">Who's making the decision?</label>
            <div class="form-radio-group" role="radiogroup" aria-labelledby="decisionLabel">
              <label><input type="radio" name="decision" value="me"> Just me</label>
              <label><input type="radio" name="decision" value="couple"> Me + spouse / partner (both should be at meeting)</label>
              <label><input type="radio" name="decision" value="family"> Family member also involved</label>
              <label><input type="radio" name="decision" value="manager"> Property manager / owner</label>
            </div>
          </div>
          <div class="form-group">
            <label for="referral">How did you find us?</label>
            <select id="referral" name="referral">
              <option value="">Choose one&hellip;</option>
              <option>Friend / neighbor referral</option>
              <option>Google search</option>
              <option>Realtor referral</option>
              <option>Saw the truck or yard sign</option>
              <option>Architect / designer referral</option>
              <option>Past client</option>
              <option>Online review</option>
              <option>Other</option>
            </select>
          </div>
        </fieldset>

        <div id="form-error" role="alert" class="form-error">
          Something went wrong. Please try again or call us directly.
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg">Submit bid request</button>
        <p class="form-hint">Sample form &mdash; submissions land in a demo inbox at Pikes Peak Web Designs.</p>
      </form>
    </div>

    <p style="margin-top:2rem;font-size:0.92rem;color:var(--text-muted);text-align:center"><a href="/sample-forms/" class="inline-link">&larr; Back to all sample forms</a> &middot; <a href="/contact/" class="inline-link">Want one like this for your business?</a></p>
  </div>
</section>
