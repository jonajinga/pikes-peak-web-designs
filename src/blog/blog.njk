---
layout: layouts/base.njk
eleventyComputed:
  title: "{% if pagination.pageNumber > 0 %}Blog; Page {{ pagination.pageNumber + 1 }} | Pikes Peak Web Designs{% else %}Blog | Pikes Peak Web Designs{% endif %}"
  description: "{% if pagination.pageNumber > 0 %}Web design tips and local SEO guides for small businesses; page {{ pagination.pageNumber + 1 }}.{% else %}Web design tips, local SEO guides, and industry-specific advice for small businesses across the U.S. and Canada.{% endif %}"
pagination:
  data: collections.posts
  size: 9
  alias: posts
  addAllPagesToCollections: true
permalink: /blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><span>Blog</span>
    </nav>
    <span class="section-label">Resources &amp; guides</span>
    <h1>Practical advice for <em>small business websites.</em></h1>
    <p>Industry-specific guides, local SEO tips, and straightforward thinking on what actually works for service businesses.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if posts.length > 0 %}
    <div class="post-list">
      {% for post in posts %}
        <article class="post-card">
          <div class="post-meta">{{ post.data.label or "Guide" }}{% if post.date %} &middot; {{ post.date | dateFormat }}{% endif %}</div>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description }}</p>
          <a href="{{ post.url }}" class="post-link">Read article</a>
        </article>
      {% endfor %}
    </div>
    {% endif %}

    {% if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Blog pages" style="display:flex;justify-content:center;gap:1rem;align-items:center;margin-top:3rem">
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="btn btn-outline-dark">&larr; Newer</a>
      {% endif %}
      <span style="color:var(--text-muted);font-size:0.9rem">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="btn btn-outline-dark">Older &rarr;</a>
      {% endif %}
    </nav>
    {% endif %}
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <span class="section-label">Ready to build?</span>
    <h2>We build the websites we write about.</h2>
    <p>$175 a month, custom-coded, everything included. The articles explain the ideas; we deliver them.</p>
    <div class="cta-buttons">
      <a href="/contact/" class="btn btn-primary btn-lg">Start a Conversation</a>
      <a href="/pricing/" class="btn btn-outline btn-lg">See Pricing</a>
    </div>
  </div>
</section>
