<script>
(function () {
  function setQuery(q) {
    if (typeof window.__ppwdSearchPrefill === 'function') {
      window.__ppwdSearchPrefill(q);
      return;
    }
    setTimeout(function () { setQuery(q); }, 200);
  }
  document.querySelectorAll('[data-prefill]').forEach(function (btn) {
    btn.addEventListener('click', function () { setQuery(btn.getAttribute('data-prefill')); });
  });

  // Recent-search history via localStorage. Captures whatever the user
  // typed once they pause for 800ms; cap at 6 entries; ignore blanks.
  var STORAGE_KEY = 'ppwd_recent_search';
  var MAX_RECENT = 6;
  function readRecent() {
    try { var raw = localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : []; }
    catch (e) { return []; }
  }
  function writeRecent(list) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, MAX_RECENT))); } catch (e) {}
  }
  function addRecent(q) {
    q = (q || '').trim();
    if (!q || q.length < 2) return;
    var list = readRecent().filter(function (x) { return x.toLowerCase() !== q.toLowerCase(); });
    list.unshift(q);
    writeRecent(list);
    renderRecent();
  }
  function renderRecent() {
    var wrap = document.querySelector('[data-search-page-recent]');
    var listEl = document.querySelector('[data-search-page-recent-list]');
    if (!wrap || !listEl) return;
    var list = readRecent();
    if (!list.length) { wrap.hidden = true; return; }
    wrap.hidden = false;
    listEl.innerHTML = list.map(function (q) {
      var safe = q.replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
      return '<button type="button" class="search-page-chip search-page-chip--recent" data-prefill="' + safe + '">' + safe + '</button>';
    }).join('');
    listEl.querySelectorAll('[data-prefill]').forEach(function (btn) {
      btn.addEventListener('click', function () { setQuery(btn.getAttribute('data-prefill')); });
    });
  }
  var clearBtn = document.querySelector('[data-search-page-recent-clear]');
  if (clearBtn) clearBtn.addEventListener('click', function () { writeRecent([]); renderRecent(); });

  var captureTimer = null;
  function attachCapture() {
    var input = document.querySelector('#pagefind-search .ppwd-search-input');
    if (!input) { setTimeout(attachCapture, 300); return; }
    input.addEventListener('input', function () {
      clearTimeout(captureTimer);
      captureTimer = setTimeout(function () { addRecent(input.value); }, 800);
    });
  }
  attachCapture();
  renderRecent();
})();
</script>
