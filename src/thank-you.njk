---
layout: layouts/base.njk
title: "Thank You | Pikes Peak Web Designs"
description: "Your message reached my inbox. Here's what happens next and how to reach me directly while you wait for my reply."
noindex: true
---

<section class="page-hero">
  <div class="container">
    <span class="section-label">Got it</span>
    <h1 id="thankHeading">I got your message</h1>
    <p id="thankSubcopy">Thanks for reaching out. I'll reply quickly on most business days.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:640px;text-align:center">
    <div style="width:72px;height:72px;margin:0 auto 1.5rem;background:var(--navy-900);border-radius:50%;display:inline-flex;align-items:center;justify-content:center">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#DDB13D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <span class="section-label">What happens next</span>
    <h2 class="section-title" style="margin-inline:auto" id="thankNextTitle">Three simple steps</h2>
    <p class="section-subtitle" style="margin-inline:auto" id="thankNextSub">Here's what to expect.</p>

    <ol class="next-steps" id="thankSteps">
      <li class="next-step">
        <span class="next-step-num">1</span>
        <div>
          <h3>I read your message</h3>
          <p>I read every message myself, with no ticket queue in between.</p>
        </div>
      </li>
      <li class="next-step">
        <span class="next-step-num">2</span>
        <div>
          <h3>I reply by email</h3>
          <p>My reply includes any follow-up questions and a couple of times that work for a call.</p>
        </div>
      </li>
      <li class="next-step">
        <span class="next-step-num">3</span>
        <div>
          <h3>We talk for 20 to 30 minutes on Google Meet</h3>
          <p>It's a relaxed conversation about your business and whether I'm the right fit for the work.</p>
        </div>
      </li>
    </ol>

    <div class="cta-buttons" style="justify-content:center;margin-top:2.5rem">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/how-it-works/" class="btn btn-outline-dark">See how it works</a>
    </div>

    <p style="margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--line);color:var(--text-muted);font-size:0.9rem">
      Need to reach me directly? <a href="tel:{{ site.phone }}" class="inline-link">{{ site.phoneDisplay }}</a> &middot; <a href="mailto:{{ site.email }}" class="inline-link">{{ site.email }}</a>
    </p>
  </div>
</section>

<script>
(function(){
  var params = new URLSearchParams(window.location.search);
  var type = params.get('type');
  var variants = {
    'onboarding': {
      h: 'Onboarding received',
      s: "Thanks for taking the time. That's everything I need to start the design, and I'll confirm soon that it all arrived.",
      nt: 'What happens next',
      ns: "You'll hear from me at each step. Here's what to expect.",
      steps: [
        ['Confirmation email', 'I send a short note confirming that everything arrived, with the schedule from here.'],
        ['Design kickoff', 'I start the design from what you sent, and you get a live preview link to share with your team.'],
        ['Launch in two to three weeks', "After your feedback and any revisions, I connect your domain, set up the security certificate, submit your sitemap to Google, and send you the owner's guide on launch day."]
      ]
    },
    'content-update': {
      h: 'Update request received',
      s: "I got it. Routine updates go live quickly on most business days, and I'll email you when the change is done.",
      nt: 'What happens next',
      ns: "Here's how a content update usually goes.",
      steps: [
        ['I review your request', "I read every request myself. If anything is unclear, I'll ask before I touch the site."],
        ['I make the change', 'Routine updates are quick. For bigger changes, I give you a timeline first, so you know what to expect.'],
        ["I confirm when it's live", "You get a short \"done\" email with a link to the updated page, so there's no dashboard to check."]
      ]
    },
    'emergency': {
      h: 'Emergency request received',
      s: "I'm on it. If you haven't already, please call or text me too, so we can work through the problem by voice.",
      nt: 'What happens next',
      ns: 'Emergency requests go to the front of the line.',
      steps: [
        ['I reply as soon as I see it', "You get an email confirming that I saw the request and I'm looking into it. If the situation is critical, I'll call you."],
        ['I find the problem', "I check the hosting, the domain settings, the code, and any recent changes until I know what's wrong."],
        ['I fix it and confirm', 'Emergencies are resolved quickly on most business days, and you get a short "fixed" email explaining what I did and what, if anything, changed.']
      ]
    },
    'design-feedback': {
      h: 'Thanks for your feedback',
      s: "I read every note, and I'll email you when the preview is updated. Revisions usually turn around quickly on most business days.",
      nt: 'What happens next',
      ns: "Here's how the revision cycle usually goes.",
      steps: [
        ['I review your notes', 'I read everything and ask by email about anything unclear before I touch the design.'],
        ['I make the changes', "If a note turns out bigger than expected, I'll tell you before I start."],
        ['I send the updated preview', "The preview comes back to you for another look, and there's no limit on rounds until you're happy. I'd rather get it right than get it fast."]
      ]
    },
    'referral': {
      h: 'Thanks for the referral',
      s: "I take referrals seriously, and yours especially. I'll reach out to them soon and keep you posted.",
      nt: 'What happens next',
      ns: "Here's how a referral usually goes from here.",
      steps: [
        ['I reach out to the business', "I mention you by name, unless you've asked me not to. It's a friendly introduction, never a hard sell."],
        ["I tell you when we've talked", 'A quick email lets you know the introduction happened and roughly how it went.'],
        ['I thank you properly if they sign', "You get one month of hosting credited to your account. If you're not a client yet, I hold the credit in your name and apply it the day you sign on. There are no cash payouts; a credit keeps things simple."]
      ]
    },
    'testimonial': {
      h: 'Thanks for your testimonial',
      s: "This helps more than I can say. I'll read it carefully and follow your choice about publishing it.",
      nt: 'What happens next',
      ns: "Here's what I do with it.",
      steps: [
        ['I read every word myself', 'Testimonials are rare for a one-person business, and I treat each one that way.'],
        ['I follow your permission choice', 'If you chose "publish with my name," the testimonial goes on the Samples page. If you chose "keep it between you and me," it stays between us.'],
        ['I thank you in return', "You get a personal email from me, and if I can do anything for you in return, I'll offer it."]
      ]
    },
    'subscribe': {
      h: 'Welcome aboard: your payment is in',
      s: "Stripe confirmed the charge, and the build begins as soon as your payment clears. The onboarding form is next, and you can fill it in on your own time.",
      nt: 'What happens next',
      ns: "Four short steps from here to launch.",
      steps: [
        ['Kickoff email today', 'You get a short note from me with the link to the onboarding form and the timeline.'],
        ['Onboarding on your own time', 'Most clients finish the onboarding form in 15 to 20 minutes. It gathers your logo if you have one, photos of your work, your services and rough pricing, your domain, and any deadlines.'],
        ['The service agreement', "If you haven't signed it yet, the sign-up page links to it. Signing takes about two minutes on your phone."],
        ['Build and launch in two to three weeks', "In the first week you get a live preview link, so you can give feedback while the work is moving. Once you're happy, I connect your domain, submit your sitemap, and send you the owner's guide on launch day."]
      ]
    },
    'hourly': {
      h: 'Hourly block received',
      s: "Stripe confirmed the charge for the hourly estimate I sent you. The work begins on the timeline we discussed.",
      nt: 'What happens next',
      ns: "Here's how the hourly work runs.",
      steps: [
        ['Confirmation email today', 'You get a short note confirming that the hours are in, the scope you approved, and the start date.'],
        ['I begin the work', 'I track my time against the estimate. If the work runs more than a few hours, you get a short progress note partway through.'],
        ['I deliver the work and settle up', 'When the work is done, you get it along with the number of hours it took. If it came in under the estimate, I credit or refund the difference. If it needs more, I quote the extra before I continue.']
      ]
    },
    'hourly-request': {
      h: 'Hourly request received',
      s: "I have the details of the work you described. A written estimate will reach your inbox within one business day, with the hours, the work, and the total spelled out.",
      nt: 'What happens next',
      ns: "Three short steps.",
      steps: [
        ['I read your request', 'I look at the work you described, your current site if you sent one, and any examples or limits you mentioned. If anything is unclear, I ask a quick question first.'],
        ['I send a written estimate within one business day', "The estimate names the hours, the work in plain English, the timeline, and the total at $100 an hour. It's the contract for the work, so there are no surprise overages."],
        ['You decide', "If the estimate looks right, you pay for the hours through the Stripe hourly checkout on the sign-up page. If it doesn't, no payment changes hands, and we can talk through other options."]
      ]
    },
    'press': {
      h: 'Press inquiry received',
      s: "Thanks for reaching out. I'll reply quickly on most business days with whatever you need.",
      nt: 'What happens next',
      ns: "Here's how press requests usually go.",
      steps: [
        ['I read your inquiry', 'I read every press inquiry myself and work to the deadline you gave on the form.'],
        ['I send what you asked for', 'A quote, the headshot, the wordmark, the fact sheet, demo screenshots, or any other asset you mentioned, attached or linked in my reply.'],
        ['A follow-up call, if you want one', "If you'd like to talk through the story on a call, reply to my email and we'll set it up."]
      ]
    },
    'ask': {
      h: 'Question received',
      s: "I read every message from the ask form myself, and I'll reply quickly on most business days.",
      nt: 'What happens next',
      ns: "Two short steps.",
      steps: [
        ['I read your message', 'I read it myself, with no queue in between.'],
        ['I reply with what you need', "Most questions get a written answer. If yours needs more than a paragraph, I'll offer a short call instead of a long email."]
      ]
    },
    'partner-program': {
      h: 'Partner inquiry received',
      s: "Thanks for reaching out about the partner program. I'll reply quickly on most business days with the next step.",
      nt: 'What happens next',
      ns: "Here's how a partnership usually gets going.",
      steps: [
        ['A 20-minute partner call', "A short conversation to check that your clients are a good match and that the program suits us both. There's no pressure and no quota."],
        ['Sign the partner agreement', 'You sign the published partner agreement by Google Docs e-signature. Every term is public and in plain English.'],
        ['Start referring', 'I accept referrals three ways: a warm introduction by email, a client mentioning you when they sign up, or the partner referral form. Each quarter, you get a check-in with the referrals received, the ones that signed, and your commission so far this year.']
      ]
    }
  };
  if (type && variants[type]) {
    var v = variants[type];
    var h = document.getElementById('thankHeading');
    var s = document.getElementById('thankSubcopy');
    var nt = document.getElementById('thankNextTitle');
    var ns = document.getElementById('thankNextSub');
    var stepsEl = document.getElementById('thankSteps');
    if (h) h.textContent = v.h;
    if (s) s.textContent = v.s;
    if (nt) nt.textContent = v.nt;
    if (ns) ns.textContent = v.ns;
    if (stepsEl && v.steps) {
      stepsEl.innerHTML = v.steps.map(function (step, i) {
        return '<li class="next-step"><span class="next-step-num">' + (i + 1) + '</span><div><h3>' + step[0] + '</h3><p>' + step[1] + '</p></div></li>';
      }).join('');
    }
  }
}());
</script>
