---
layout: layouts/base.njk
title: "Thanks! | Pikes Peak Web Designs"
description: "I got your message. Here's what happens next and how to reach me while you wait."
noindex: true
---

<section class="page-hero">
  <div class="container">
    <span class="section-label">Got it</span>
    <h1 id="thankHeading">I got your message.</h1>
    <p id="thankSubcopy">Thanks for reaching out. I tend to be in touch quickly on most business days.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:640px;text-align:center">
    <div style="width:72px;height:72px;margin:0 auto 1.5rem;background:var(--navy-900);border-radius:50%;display:inline-flex;align-items:center;justify-content:center">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#DDB13D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <span class="section-label">What happens next</span>
    <h2 class="section-title" style="margin-inline:auto" id="thankNextTitle">Three simple steps.</h2>
    <p class="section-subtitle" style="margin-inline:auto" id="thankNextSub">Here is what to expect from here.</p>

    <ol class="next-steps" id="thankSteps">
      <li class="next-step">
        <span class="next-step-num">1</span>
        <div>
          <h3>I read your message.</h3>
          <p>A real person reads it, not a ticket queue, and the read tends to happen quickly on most business days.</p>
        </div>
      </li>
      <li class="next-step">
        <span class="next-step-num">2</span>
        <div>
          <h3>I reply quickly on most business days.</h3>
          <p>You will hear from me by email, with any follow-up questions and a couple of times that work for a call.</p>
        </div>
      </li>
      <li class="next-step">
        <span class="next-step-num">3</span>
        <div>
          <h3>A 20-minute call on Google Meet.</h3>
          <p>There is no pressure attached and no pitch involved, only a conversation about your business and whether I am the right fit for the work.</p>
        </div>
      </li>
    </ol>

    <div class="cta-buttons" style="justify-content:center;margin-top:2.5rem">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/how-it-works/" class="btn btn-outline-dark">See How It Works</a>
    </div>

    <p style="margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--line);color:var(--text-muted);font-size:0.9rem">
      Need to reach me directly? <a href="tel:{{ site.phone }}" class="inline-link">{{ site.phoneDisplay }}</a> &middot; <a href="mailto:{{ site.email }}" class="inline-link">{{ site.email }}</a>
    </p>
  </div>
</section>

<script>
(function(){
  var params = new URLSearchParams(window.location.search);
  var type = params.get('type');
  var variants = {
    'onboarding': {
      h: 'Onboarding received.',
      s: "Thanks for taking the time; that's everything I need to get started. I will confirm receipt soon and kick off the build shortly after.",
      nt: 'What happens next.',
      ns: "You won't hear silence from me. Here's what to expect.",
      steps: [
        ['Confirmation email.', 'You will get a short note from me confirming I received everything and outlining the schedule from here.'],
        ['Design kickoff.', 'I start the design based on what you sent. You will get a live preview link to share with your team in short order.'],
        ['Launch in roughly two to three weeks.', 'After your feedback and any revisions, I handle DNS, SSL, sitemap submission, and the launch-day owner\'s guide on your behalf.']
      ]
    },
    'content-update': {
      h: 'Update request received.',
      s: "I got it. Routine updates tend to go live quickly on most business days, and I will email you when the change is done.",
      nt: 'What happens next.',
      ns: "Here's the typical flow for a content update.",
      steps: [
        ['I review your request.', 'I read every request that comes in, and the read happens quickly on most business days. If anything is unclear, I will reply for clarification before I touch the site.'],
        ['I make the change.', 'Routine updates tend to go live quickly on most business days. Bigger changes get a timeline first, so you know what to expect from your side.'],
        ['I confirm when it is live.', 'You will get a short "done" email with a link to the updated page. There is no dashboard to check, since the confirmation simply shows up in your inbox.']
      ]
    },
    'emergency': {
      h: 'Emergency request received.',
      s: "I am on it. If you have not already, please also call or text me so I can triage by voice.",
      nt: 'What happens next.',
      ns: 'Emergency requests skip the queue.',
      steps: [
        ['I acknowledge as soon as I see it.', 'You will get an email confirming I saw the request and am investigating, and if the situation is critical I will call you directly.'],
        ['I diagnose the problem.', 'I check hosting, DNS, the code, and any recent changes, doing whatever it takes to identify what is actually going wrong.'],
        ['I fix and confirm.', 'Emergencies tend to get resolved quickly on most business days, and you will get a short "fixed" email explaining what I did and what, if anything, changed.']
      ]
    },
    'design-feedback': {
      h: 'Feedback received. Thank you.',
      s: "I read every note that comes in. Revision rounds tend to turn around quickly on most business days, and I will email you when the preview is updated.",
      nt: 'What happens next.',
      ns: "Here's how the revision cycle usually goes.",
      steps: [
        ['I review your notes.', 'I read through everything and flag anything that needs clarification by email before I touch the design.'],
        ['I implement the changes.', 'Revisions tend to turn around quickly on most business days, and if any note is bigger than expected I will tell you before I start.'],
        ['I send the updated preview.', 'The preview comes back to you for another pass, and there is no limit on rounds until you are happy with the result. I would rather get it right than get it fast.']
      ]
    },
    'referral': {
      h: 'Referral received. Thank you.',
      s: "I take referrals seriously, and yours especially so. I will reach out to them soon and keep you in the loop along the way.",
      nt: 'What happens next.',
      ns: "Here's how referrals typically go from here.",
      steps: [
        ['I reach out to the business.', 'I get in touch quickly on most business days, and I mention you by name unless you have asked me not to. There is no pushy sales pitch attached, only an introduction.'],
        ['I tell you when contact happens.', 'A quick email goes out to you so you know the intro happened and roughly how it went on the other end.'],
        ['I thank you properly if they sign.', 'You get one month of hosting credited to your account if you are already a client, or a simple cash thank-you if you are not.']
      ]
    },
    'testimonial': {
      h: 'Testimonial received. Thank you.',
      s: "This genuinely helps, more than I can say. I will read it carefully and follow your preferences on publishing it.",
      nt: 'What happens next.',
      ns: "Here's what I do with it.",
      steps: [
        ['I read it personally, every word of it.', 'Testimonials are rare for a sole-proprietor agency, and I treat them that way.'],
        ['I follow your permission choice.', 'If you said "publish with my name," the testimonial goes onto the Samples page in short order. If you said "keep it between you and me," it stays exactly there.'],
        ['I say thank you back.', 'You get a real email from me, not an autoresponder, and if there is anything I can do for you in return I will offer it.']
      ]
    }
  };
  if (type && variants[type]) {
    var v = variants[type];
    var h = document.getElementById('thankHeading');
    var s = document.getElementById('thankSubcopy');
    var nt = document.getElementById('thankNextTitle');
    var ns = document.getElementById('thankNextSub');
    var stepsEl = document.getElementById('thankSteps');
    if (h) h.textContent = v.h;
    if (s) s.textContent = v.s;
    if (nt) nt.textContent = v.nt;
    if (ns) ns.textContent = v.ns;
    if (stepsEl && v.steps) {
      stepsEl.innerHTML = v.steps.map(function (step, i) {
        return '<li class="next-step"><span class="next-step-num">' + (i + 1) + '</span><div><h3>' + step[0] + '</h3><p>' + step[1] + '</p></div></li>';
      }).join('');
    }
  }
}());
</script>
