---
layout: layouts/base.njk
title: "Thanks! | Pikes Peak Web Designs"
description: "I got your message. Here's what happens next and how to reach me while you wait."
noindex: true
---

<section class="page-hero">
  <div class="container">
    <span class="section-label">Got it</span>
    <h1 id="thankHeading">I got your message.</h1>
    <p id="thankSubcopy">Thanks for reaching out. I will be in touch within one business day. usually sooner.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:640px;text-align:center">
    <div style="width:72px;height:72px;margin:0 auto 1.5rem;background:var(--navy-900);border-radius:50%;display:inline-flex;align-items:center;justify-content:center">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#DDB13D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <span class="section-label">What happens next</span>
    <h2 class="section-title" style="margin-inline:auto" id="thankNextTitle">Three simple steps.</h2>
    <p class="section-subtitle" style="margin-inline:auto" id="thankNextSub">Here's what to expect over the next business day or two.</p>

    <ol class="next-steps" id="thankSteps">
      <li class="next-step">
        <span class="next-step-num">1</span>
        <div>
          <h3>I read your message.</h3>
          <p>A real person, not a ticket queue. usually within an hour or two during business hours.</p>
        </div>
      </li>
      <li class="next-step">
        <span class="next-step-num">2</span>
        <div>
          <h3>I reply within one business day.</h3>
          <p>You'll hear from us by email with any follow-up questions and a couple of times that work for a call.</p>
        </div>
      </li>
      <li class="next-step">
        <span class="next-step-num">3</span>
        <div>
          <h3>A 20-minute call on Google Meet.</h3>
          <p>No pressure, no pitch. just a conversation about your business and whether I am the right fit.</p>
        </div>
      </li>
    </ol>

    <div class="cta-buttons" style="justify-content:center;margin-top:2.5rem">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/how-it-works/" class="btn btn-outline-dark">See How It Works</a>
    </div>

    <p style="margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--line);color:var(--text-muted);font-size:0.9rem">
      Need to reach me directly? <a href="tel:{{ site.phone }}" class="inline-link">{{ site.phoneDisplay }}</a> &middot; <a href="mailto:{{ site.email }}" class="inline-link">{{ site.email }}</a>
    </p>
  </div>
</section>

<script>
(function(){
  var params = new URLSearchParams(window.location.search);
  var type = params.get('type');
  var variants = {
    'onboarding': {
      h: 'Onboarding received.',
      s: "Thanks for taking the time; that's everything I need to get started. I will confirm receipt today and kick off the build this week.",
      nt: 'What happens next.',
      ns: "You won't hear silence from us. Here's what to expect.",
      steps: [
        ['Today: confirmation email.', 'You\'ll get a short note from me today confirming I received everything and outlining the schedule.'],
        ['This week: design kickoff.', 'I start the design based on what you sent. You\'ll get a live preview link within 3 to 5 business days.'],
        ['Within 2 to 3 weeks: launch.', 'After your feedback and any revisions, I handle DNS, SSL, sitemap submission, and the launch-day owner\'s guide.']
      ]
    },
    'content-update': {
      h: 'Update request received.',
      s: "I got it. Routine updates are usually live within one business day; I will email you when it's done.",
      nt: 'What happens next.',
      ns: "Here's the typical flow for a content update.",
      steps: [
        ['I review your request.', 'Usually within an hour or two during business hours. If anything is unclear, I will reply for clarification.'],
        ['I make the change.', 'Routine updates go live the same business day. Bigger changes get a timeline first, so you know what to expect.'],
        ['I confirm when it\'s live.', 'You\'ll get a "done" email with a link to the updated page. No dashboard to check; it just shows up in your inbox.']
      ]
    },
    'emergency': {
      h: 'Emergency request received.',
      s: "I am on it. If you have not already, please also call or text me so I can triage by voice.",
      nt: 'What happens next.',
      ns: 'Emergency requests skip the queue.',
      steps: [
        ['I acknowledge within minutes.', 'You\'ll get an email confirming I saw the request and am investigating. If it is critical, I will call you.'],
        ['I diagnose.', 'I check hosting, DNS, the code, recent changes; whatever it takes to identify the problem.'],
        ['I fix and confirm.', 'Most emergencies are resolved within the hour during business hours. You\'ll get a "fixed" email explaining what I did and what, if anything, changed.']
      ]
    },
    'design-feedback': {
      h: 'Feedback received. Thank you.',
      s: "I read every note. Most revision rounds turn around in one to two business days; I will email when the preview is updated.",
      nt: 'What happens next.',
      ns: "Here's how the revision cycle usually goes.",
      steps: [
        ['I review your notes.', 'Today or tomorrow morning at the latest. I will flag anything that needs clarification by email.'],
        ['I implement the changes.', 'Usually one to two business days. If any note is bigger than expected, I will tell you before I start.'],
        ['I send the updated preview.', 'Back to you for another pass. No limit on rounds until you are happy; I would rather get it right than get it fast.']
      ]
    },
    'referral': {
      h: 'Referral received. Thank you.',
      s: "I take referrals seriously, yours especially. I will reach out to them soon and keep you in the loop.",
      nt: 'What happens next.',
      ns: "Here's how referrals typically go from here.",
      steps: [
        ['I reach out to the business.', 'Within one to two business days, mentioning you by name (unless you asked me not to). No pushy sales pitch; just an introduction.'],
        ['I tell you when contact happens.', 'A quick email so you know the intro happened and roughly how it went.'],
        ['I thank you properly if they sign.', 'One month of hosting credited to your account if you\'re a client, or a simple cash thank-you if you\'re not.']
      ]
    },
    'testimonial': {
      h: 'Testimonial received. Thank you.',
      s: "This genuinely helps, more than I can say. I will read it carefully and follow your preferences on publishing.",
      nt: 'What happens next.',
      ns: "Here's what I do with it.",
      steps: [
        ['I read it; every word.', 'Personally. Testimonials are rare and I treat them that way.'],
        ['I follow your permission choice.', 'If you said "publish with my name," it goes on the Samples page within a week. If you said "keep it between you and me," it stays there.'],
        ['I say thank you back.', 'A real email, not an autoresponder. If there is anything I can do for you in return, I will offer.']
      ]
    }
  };
  if (type && variants[type]) {
    var v = variants[type];
    var h = document.getElementById('thankHeading');
    var s = document.getElementById('thankSubcopy');
    var nt = document.getElementById('thankNextTitle');
    var ns = document.getElementById('thankNextSub');
    var stepsEl = document.getElementById('thankSteps');
    if (h) h.textContent = v.h;
    if (s) s.textContent = v.s;
    if (nt) nt.textContent = v.nt;
    if (ns) ns.textContent = v.ns;
    if (stepsEl && v.steps) {
      stepsEl.innerHTML = v.steps.map(function (step, i) {
        return '<li class="next-step"><span class="next-step-num">' + (i + 1) + '</span><div><h3>' + step[0] + '</h3><p>' + step[1] + '</p></div></li>';
      }).join('');
    }
  }
}());
</script>
