---
layout: layouts/base.njk
---

<section class="page-hero page-hero--peak">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><a href="/case-studies/">Case studies</a><span class="sep">/</span><span>{{ client }}</span>
    </nav>
    <span class="section-label">{{ trade }}{% if metro %} &middot; {{ metro }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if summary %}<p>{{ summary }}</p>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:980px">

    {% if metrics and metrics.length %}
    <div class="case-metrics" aria-label="Outcome metrics">
      {% for m in metrics %}
        <div class="case-metric">
          <span class="case-metric-label">{{ m.label }}</span>
          <div class="case-metric-row">
            <span class="case-metric-before">{{ m.before }}</span>
            <span class="case-metric-arrow" aria-hidden="true">&rarr;</span>
            <span class="case-metric-after">{{ m.after }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="prose" style="margin-top:2.5rem">
      {{ content | safe }}
    </div>

    <nav aria-label="Back to case studies" style="margin-top:3rem;display:flex;justify-content:center">
      <a href="/case-studies/" class="btn btn-outline-dark">&larr; All case studies</a>
    </nav>

  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <span class="section-label">Ready to see numbers like this on your site?</span>
    <h2>Twenty minutes is plenty.</h2>
    <p>Book a discovery call. Bring your URL and your goals. I will tell you honestly what is achievable and what is not.</p>
    <div class="cta-buttons">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a discovery call</a>
      <a href="/audit/" class="btn btn-outline btn-lg">Get a free audit instead</a>
    </div>
  </div>
</section>
