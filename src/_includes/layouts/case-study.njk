---
layout: layouts/base.njk
---

<article class="case-study">

{# Print-only cover page. Shown only via @media print so the PDF reads
   as a real document with a branded title page, meta, and exec summary
   before the body. Aria-hidden so screen readers skip the duplicate. #}
<aside class="case-study-print-cover" aria-hidden="true">
  <div class="case-study-print-cover-brand">
    <span class="case-study-print-cover-mark">P</span>
    <span class="case-study-print-cover-wordmark">
      <strong>Pikes Peak</strong> Web Designs
    </span>
  </div>
  <div class="case-study-print-cover-tagline">{{ site.voice.markline or 'Custom-coded. Custom-cared-for.' }}</div>
  <div class="case-study-print-cover-rule"></div>
  <span class="case-study-print-cover-eyebrow">Case Study</span>
  <h1 class="case-study-print-cover-title">{{ title }}</h1>
  <div class="case-study-print-cover-meta">
    <strong>{{ client }}</strong>{% if trade %} &middot; {{ trade }}{% endif %}{% if metro %} &middot; {{ metro }}{% endif %}
  </div>
  {% if summary %}<p class="case-study-print-cover-summary">{{ summary }}</p>{% endif %}
  {% if metrics and metrics.length %}
  <div class="case-study-print-cover-summary-block">
    <span class="case-study-print-cover-summary-label">Executive summary</span>
    <ul class="case-study-print-cover-bullets">
      {% for m in metrics %}
        <li><strong>{{ m.label }}:</strong> {{ m.value or m.after }}{% if m.note %} &mdash; {{ m.note }}{% endif %}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  <div class="case-study-print-cover-foot">
    <div>
      <span class="case-study-print-cover-foot-label">Prepared by</span>
      <span class="case-study-print-cover-foot-value">Pikes Peak Web Designs &middot; pikespeakwebdesigns.com</span>
    </div>
    {% if liveUrl %}
    <div>
      <span class="case-study-print-cover-foot-label">Live URL</span>
      <span class="case-study-print-cover-foot-value">{{ liveUrl | replace("https://", "") | replace("http://", "") }}</span>
    </div>
    {% endif %}
    <div>
      <span class="case-study-print-cover-foot-label">Document date</span>
      <span class="case-study-print-cover-foot-value">{{ "" | currentYear }}</span>
    </div>
  </div>
</aside>

<section class="page-hero page-hero--peak">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><a href="/case-studies/">Case studies</a><span class="sep">/</span><span>{{ client }}</span>
    </nav>
    <span class="section-label">{{ trade }}{% if metro %} &middot; {{ metro }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if summary %}<p>{{ summary }}</p>{% endif %}
    <div class="case-study-toolbar" role="toolbar" aria-label="Case study actions">
      <button type="button" class="btn btn-outline btn-sm" onclick="window.print()" aria-label="Print or save as PDF">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Print / Save as PDF
      </button>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:980px">

    {% if metrics and metrics.length %}
    <div class="case-metrics{% if greenfield %} case-metrics--greenfield{% endif %}" aria-label="Outcome metrics">
      {% for m in metrics %}
        <div class="case-metric">
          <span class="case-metric-label">{{ m.label }}</span>
          {% if greenfield or m.value %}
            <div class="case-metric-value">{{ m.value or m.after }}</div>
            {% if m.note %}<p class="case-metric-note">{{ m.note }}</p>{% endif %}
          {% else %}
            <div class="case-metric-row">
              <span class="case-metric-before">{{ m.before }}</span>
              <span class="case-metric-arrow" aria-hidden="true">&rarr;</span>
              <span class="case-metric-after">{{ m.after }}</span>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="prose case-study-body" style="margin-top:2.5rem">
      {{ content | safe }}
    </div>

    <nav aria-label="Back to case studies" class="case-study-back" style="margin-top:3rem;display:flex;justify-content:center">
      <a href="/case-studies/" class="btn btn-outline-dark">&larr; All case studies</a>
    </nav>

  </div>
</section>

<section class="cta-section case-study-cta">
  <div class="cta-inner">
    <span class="section-label">Ready to see numbers like this on your site?</span>
    <h2>Twenty minutes is plenty.</h2>
    <p>Book a discovery call. Bring your URL and your goals. I will tell you honestly what is achievable and what is not.</p>
    <div class="cta-buttons">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a discovery call</a>
      <a href="/audit/" class="btn btn-outline btn-lg">Get a free audit instead</a>
    </div>
  </div>
</section>

</article>
