<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  {#- color-scheme meta is parsed by the user agent BEFORE any CSS, so
      the browser's "initial canvas" (the blank background painted
      between the HTML arriving and the inline <style> finishing
      parse) gets painted in dark when the system / stored preference
      is dark, instead of the user-agent default white that produced
      the flash on every navigation. The inline no-flash script
      below then sets style.colorScheme on <html> explicitly to
      lock in the stored preference even when it disagrees with the
      system. -#}
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0A1F44" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#071125" media="(prefers-color-scheme: dark)">
  <title>{{ title if title else site.name }}</title>
  <meta name="description" content="{{ description if description else site.description }}">
  {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}

  <script>(function(){try{var t=localStorage.getItem('pp-theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';var r=document.documentElement;r.setAttribute('data-theme',t);r.style.colorScheme=t;r.style.background=t==='dark'?'#071125':'#FFFFFF';}catch(e){}})();</script>

  {% include "partials/critical-css.njk" %}

  {# The full stylesheet loads before the first paint. It used to load
     asynchronously (preload + onload swap) behind the inlined critical
     CSS, but the critical subset could never cover every page and
     screen size: the page painted half-styled, then snapped into its
     real layout when this file arrived, and every CSS transition fired
     on the restyle (buttons fading in, the phone bar sliding). One
     cacheable file; after the first visit it costs nothing. #}
  <link rel="stylesheet" href="/assets/css/style.css">

  {# Preload both font files. Each is a variable font that carries every
     weight the site uses, so once these two arrive no text on the page
     swaps typeface. @font-face declarations live in the inlined critical
     CSS above. #}
  {# Favicon stack. The SVG carries embedded prefers-color-scheme CSS
     so it adapts to dark browser UI in modern Safari / Firefox / Chrome.
     PNG variants cover everything else: 16/32/48 for tab and Windows
     shortcut, 180 for iOS home-screen, 192/512 for Android + PWA.
     site.webmanifest declares the 512 maskable variant for Android
     adaptive icons. #}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  {# Pagefind's default UI (pagefind-ui.css/js) is no longer used; the
     custom .ppwd-search UI loads /pagefind/pagefind.js on demand. The
     two preloads were ~14 KiB of dead weight on every page. #}

  {# OG image resolution: per-page ogImage > site default. Always served as PNG
     at 1200x630, the canonical Open Graph aspect ratio across Facebook,
     LinkedIn, X, iMessage, Slack, and Discord. #}
  {% set _ogImage = ogImage if ogImage else site.ogImage %}
  {% set _ogImageAlt = ogImageAlt if ogImageAlt else (description if description else site.description) %}
  <meta property="og:title" content="{{ title if title else site.name }}">
  <meta property="og:description" content="{{ description if description else site.description }}">
  <meta property="og:type" content="{{ ogType if ogType else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ _ogImage }}">
  <meta property="og:image:secure_url" content="{{ site.url }}{{ _ogImage }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ _ogImageAlt }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale or 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title if title else site.name }}">
  <meta name="twitter:description" content="{{ description if description else site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ _ogImage }}">
  <meta name="twitter:image:alt" content="{{ _ogImageAlt }}">
  {% if site.twitterHandle %}
  <meta name="twitter:site" content="{{ site.twitterHandle }}">
  <meta name="twitter:creator" content="{{ site.twitterHandle }}">
  {% endif %}
  {% if ogType == 'article' %}
    {% if date %}<meta property="article:published_time" content="{{ date | dateISO }}">{% endif %}
    {% if updated %}<meta property="article:modified_time" content="{{ updated | dateISO }}">{% elif date %}<meta property="article:modified_time" content="{{ date | dateISO }}">{% endif %}
    <meta property="article:author" content="{{ site.url }}/about/">
    {% if label %}<meta property="article:section" content="{{ label }}">{% endif %}
    {% if tags %}{% for tag in tags %}{% if tag != 'post' %}<meta property="article:tag" content="{{ tag }}">{% endif %}{% endfor %}{% endif %}
  {% endif %}
  {% include "partials/structured-data.njk" %}
  {% if extraHead %}{{ extraHead | safe }}{% endif %}

  {# Analytics, only injected when real IDs are set in site data. Placeholder
     IDs would trigger CORS / 400 errors and leak into the console, so we
     conditionally render. Set site.umamiWebsiteId / site.cloudflareBeaconToken
     to enable. #}
  {% if site.umamiWebsiteId %}
  {#- Umami analytics: load AFTER the page hits LCP rather than during
      the critical path. Defer alone still queues the request during
      HTML parse, contending with bandwidth that could be serving the
      font + CSS the hero needs. Triggering on the load event delays
      Umami to ~Time-to-Interactive-ish, which is exactly when
      analytics SHOULD start (the user has the page; tracking begins).
      Falls back to a 4s setTimeout in case the load event has already
      fired by the time this script parses (it has on bfcache restores). -#}
  <script>
    (function(){
      var loaded = false;
      function loadUmami(){
        if (loaded) return; loaded = true;
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://cloud.umami.is/script.js';
        s.dataset.websiteId = '{{ site.umamiWebsiteId }}';
        document.head.appendChild(s);
        var t = document.createElement('script');
        t.defer = true;
        t.src = '/assets/js/umami-tracking.js';
        document.head.appendChild(t);
      }
      if (document.readyState === 'complete') {
        setTimeout(loadUmami, 0);
      } else {
        addEventListener('load', function(){ setTimeout(loadUmami, 0); }, { once: true });
        // Belt-and-suspenders: 4-second fallback so analytics never hangs
        // if the load event is suppressed by some edge case.
        setTimeout(loadUmami, 4000);
      }
    })();
  </script>
  {% endif %}
  {% if site.cloudflareBeaconToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareBeaconToken }}"}'></script>
  {% endif %}
</head>
<body{% if noindex %} data-pagefind-ignore="all"{% endif %}>
<a href="#main-content" class="skip-link">Skip to content</a>

{% include "partials/promo-banner.njk" %}
{% include "partials/topbar.njk" %}
{% include "partials/nav.njk" %}

<main id="main-content">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}
{% include "partials/mobile-action-bar.njk" %}

<button class="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<div class="search-modal" id="searchModal" role="dialog" aria-modal="true" aria-label="Search the site" hidden>
  <div class="search-modal-backdrop" data-close-search></div>
  <div class="search-modal-panel">
    <div class="search-modal-head">
      <div class="search-modal-head-text">
        <span class="section-label" style="margin:0">Search</span>
        <p class="search-modal-sub">Search every page, service area, and FAQ on the site.</p>
      </div>
      <button class="search-modal-close" type="button" aria-label="Close search" data-close-search>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="pagefind-search" class="search-panel"></div>
    <div class="search-modal-suggest">
      <span class="search-modal-suggest-label">Popular pages</span>
      <div class="search-modal-chips">
        <a href="/pricing/" class="search-chip">Pricing</a>
        <a href="/how-it-works/" class="search-chip">How it works</a>
        <a href="/samples/" class="search-chip">Sample sites</a>
        <a href="/faq/" class="search-chip">FAQ</a>
        <a href="/contact/" class="search-chip">Free call</a>
        <a href="/subscribe/" class="search-chip">Sign up</a>
      </div>
    </div>
    <div class="search-modal-foot">
      <span>Press <kbd>/</kbd> to open search from any page</span>
      <span>Press <kbd>Esc</kbd> to close</span>
    </div>
  </div>
</div>

<script src="/assets/js/main.js" defer></script>
{# Tooltips (Tippy + Popper) load on a visitor's first touch, hover, or
   keyboard focus on a term, so they never compete with the first paint.
   main.js exposes ppInitTippy() to switch them on once the files arrive;
   the term that triggered the load then shows its tooltip. The URLs are
   pinned, which also skips unpkg's version redirects. Before this, the
   files loaded during page load and usually arrived after main.js had
   already tried (and failed) to initialise them. #}
<script>
(function () {
  var sel = '[data-term], [data-tooltip], a[href*="/glossary/#"]';
  if (!document.querySelector(sel)) return;
  var events = ['pointerover', 'focusin', 'touchstart'];
  var started = false;
  function load(src) {
    return new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = src; s.async = true;
      s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
  }
  function start(e) {
    var t = e.target && e.target.closest ? e.target.closest(sel) : null;
    if (started || !t) return;
    started = true;
    events.forEach(function (n) { document.removeEventListener(n, start, true); });
    load('https://unpkg.com/@popperjs/core@2.11.8/dist/umd/popper.min.js')
      .then(function () { return load('https://unpkg.com/tippy.js@6.3.7/dist/tippy-bundle.umd.min.js'); })
      .then(function () {
        if (window.ppInitTippy) window.ppInitTippy();
        if (t._tippy) t._tippy.show();
      })
      .catch(function () { /* tooltips are an enhancement; ignore */ });
  }
  events.forEach(function (n) { document.addEventListener(n, start, { capture: true, passive: true }); });
})();
</script>
</body>
</html>
