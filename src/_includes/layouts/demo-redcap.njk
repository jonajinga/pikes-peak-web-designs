    <a href="/samples/">&larr; Back to Samples</a>
    <a href="/contact/">Get a site like this &rarr;</a>
  </div>
</div>

<header class="demo-header">
  <div class="demo-header-inner">
    <a href="/demo/redcap-roofing/" class="demo-logo">
      <span class="demo-logo-mark">R</span>
      <span>Redcap <span class="demo-logo-accent">Roofing</span></span>
    </a>

    <nav class="demo-nav" aria-label="Main navigation">
      <a href="/demo/redcap-roofing/"{% if page.url == '/demo/redcap-roofing/' %} class="is-active"{% endif %}>Home</a>
      <a href="/demo/redcap-roofing/services/"{% if page.url | startsWith('/demo/redcap-roofing/services/') or page.url | startsWith('/demo/redcap-roofing/residential/') or page.url | startsWith('/demo/redcap-roofing/commercial/') %} class="is-active"{% endif %}>Services</a>
      <a href="/demo/redcap-roofing/service-area/"{% if page.url | startsWith('/demo/redcap-roofing/service-area/') %} class="is-active"{% endif %}>Service Area</a>
      <a href="/demo/redcap-roofing/about/"{% if page.url | startsWith('/demo/redcap-roofing/about/') %} class="is-active"{% endif %}>About</a>
      <a href="tel:7195550143" class="demo-nav-phone">(719) 555-0143</a>
      <a href="/demo/redcap-roofing/contact/" class="demo-nav-cta">Free Inspection</a>
    </nav>

    <button class="demo-menu-toggle" type="button" aria-label="Toggle menu" onclick="document.getElementById('demoMobileNav').classList.toggle('is-open')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<div class="demo-mobile-nav" id="demoMobileNav">
  <a href="tel:7195550143">Call (719) 555-0143</a>
  <a href="/demo/redcap-roofing/">Home</a>
  <a href="/demo/redcap-roofing/services/">Services</a>
  <a href="/demo/redcap-roofing/residential/">Residential</a>
  <a href="/demo/redcap-roofing/commercial/">Commercial</a>
  <a href="/demo/redcap-roofing/service-area/">Service Area</a>
  <a href="/demo/redcap-roofing/about/">About</a>
  <a href="/demo/redcap-roofing/contact/" class="demo-nav-cta">Free Inspection</a>
</div>

<main id="main-content">
  {{ content | safe }}
</main>

