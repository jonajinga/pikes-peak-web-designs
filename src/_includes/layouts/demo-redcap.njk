    <div>
      <h4>Company</h4>
      <a href="/demo/redcap-roofing/about/">About</a>
      <a href="/demo/redcap-roofing/service-area/">Service Area</a>
      <a href="/demo/redcap-roofing/testimonials/">Testimonials</a>
      <a href="/demo/redcap-roofing/contact/">Contact</a>
      <a href="/demo/redcap-roofing/contact/">Free Inspection</a>
    </div>

    <div>
      <h4>Contact</h4>
      <p style="margin-bottom:0.5rem"><strong style="color:#FFFFFF">Redcap Roofing</strong></p>
      <a href="tel:7195550143" style="color:var(--demo-accent);font-weight:600">(719) 555-0143</a>
      <a href="mailto:roof@redcaproofing.example">roof@redcaproofing.example</a>
      <p style="margin-top:0.5rem;font-size:0.88rem">2100 N. Circle Drive<br>Colorado Springs, CO 80909</p>
      <p style="font-size:0.82rem;color:rgba(255,255,255,0.58)">Mon&ndash;Fri 7am&ndash;5pm<br>24/7 storm response</p>
