<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#1A1F2E">
  <title>{{ title if title else "Redcap Roofing | Colorado Springs Roofing & Storm Damage Specialists" }}</title>
  <meta name="description" content="{{ description if description else 'Family-owned Colorado Springs roofing company. Free inspections, insurance claim assistance, GAF Master Elite certified. Same-day estimates, 5-year workmanship warranty.' }}">
  <link rel="canonical" href="https://pikespeakwebdesigns.com/samples/">
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="https://fonts.bunny.net/oswald/files/oswald-latin-600-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="https://fonts.bunny.net/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2" crossorigin>
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=oswald:500,600|ibm-plex-sans:400,600|ibm-plex-mono:400&display=swap" media="print" onload="this.media='all'">
