---
layout: layouts/demo-lumen.njk
---

{% set postUrl = 'https://pikespeakwebdesigns.com' + page.url %}
{% set postTitle = title %}

<div style="position:fixed;top:0;left:0;right:0;height:3px;background:transparent;z-index:90;pointer-events:none">
  <span id="demoPostProgressBar" style="display:block;height:100%;width:0;background:var(--lu-yellow);transition:width 0.1s linear"></span>
</div>

<article>
  <section class="lumen-page-hero">
    <div class="lumen-container lumen-container--narrow">
      <nav class="lumen-breadcrumb" aria-label="Breadcrumb">
        <a href="/demo/lumen-electric/">Home</a><span class="sep">/</span><a href="/demo/lumen-electric/blog/">Notes</a><span class="sep">/</span><span>Article</span>
      </nav>
      {% if eyebrow %}<span class="lumen-eyebrow">{{ eyebrow }}</span>{% endif %}
      <h1 style="max-width:24ch">{{ title }}</h1>
      <p style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:0.82rem;color:var(--lu-gray-light);letter-spacing:0.06em;text-transform:uppercase;margin-top:0.85rem">
        {% if date %}{{ date | dateFormat }}{% endif %}{% if author %} &middot; {{ author }}{% else %} &middot; Lumen Electric{% endif %}{% if readingTime %} &middot; {{ readingTime }}{% endif %}
      </p>
    </div>
  </section>

  <section class="lumen-section">
    <div class="lumen-container" style="max-width:1100px">
      <div style="display:grid;grid-template-columns:240px 1fr;gap:3rem;align-items:start">

        <aside class="demo-post-toc" aria-label="In this article" style="position:sticky;top:5rem;align-self:start;font-family:'Inter',sans-serif">
          <span style="display:block;font-family:'Archivo','Inter',sans-serif;font-size:0.78rem;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:var(--lu-gray);margin-bottom:1rem">In this article</span>
          <ol id="demoPostTocList" style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.4rem;font-size:0.92rem"></ol>
        </aside>

        <div id="demoPostContent" style="line-height:1.75;color:var(--lu-ink);font-size:1.05rem;min-width:0">
          {{ content | safe }}

          {% include "partials/demo-post-share.njk" %}

          <hr style="border:0;border-top:1px solid var(--lu-line);margin:2.5rem 0 2rem">

          <div style="background:var(--lu-bone);border-left:4px solid var(--lu-yellow);padding:1.5rem 1.75rem">
            <span class="lumen-eyebrow" style="margin-bottom:0.5rem">Need an electrician?</span>
            <h3 style="font-family:'Archivo',sans-serif;font-size:1.4rem;font-weight:800;letter-spacing:-0.01em;color:var(--lu-black);margin:0 0 0.5rem;text-transform:uppercase">Same-day quotes. Code-compliant work.</h3>
            <p style="margin:0 0 1.25rem;color:var(--lu-ink);line-height:1.65">Licensed, insured, and pulling permits when the job calls for it. The diagnostic visit is one trip and one written quote.</p>
            <a href="/demo/lumen-electric/contact/" class="lumen-btn lumen-btn-primary">Book a job</a>
          </div>

          {% set posts = collections.lumenPost %}
          {% set currentIndex = -1 %}
          {% for p in posts %}{% if p.url === page.url %}{% set currentIndex = loop.index0 %}{% endif %}{% endfor %}
          {% if posts.length > 1 %}
          <nav aria-label="More articles" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:2.5rem 0 2rem">
            {% set prevIndex = currentIndex - 1 %}
            {% set nextIndex = currentIndex + 1 %}
            {% if prevIndex >= 0 %}
              {% set prev = posts[prevIndex] %}
              <a href="{{ prev.url }}" style="padding:1rem 1.15rem;background:var(--lu-bone);border:1px solid var(--lu-line);color:var(--lu-ink);text-decoration:none;display:flex;flex-direction:column;gap:0.3rem">
                <span style="font-family:'Archivo',sans-serif;font-size:0.72rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:var(--lu-gray)">&larr; Previous</span>
                <strong style="font-family:'Archivo',sans-serif;font-weight:800;color:var(--lu-black);text-transform:uppercase;font-size:0.95rem">{{ prev.data.title }}</strong>
              </a>
            {% else %}<span></span>{% endif %}
            {% if nextIndex < posts.length %}
              {% set nxt = posts[nextIndex] %}
              <a href="{{ nxt.url }}" style="padding:1rem 1.15rem;background:var(--lu-bone);border:1px solid var(--lu-line);color:var(--lu-ink);text-decoration:none;display:flex;flex-direction:column;gap:0.3rem;text-align:right">
                <span style="font-family:'Archivo',sans-serif;font-size:0.72rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:var(--lu-gray)">Next &rarr;</span>
                <strong style="font-family:'Archivo',sans-serif;font-weight:800;color:var(--lu-black);text-transform:uppercase;font-size:0.95rem">{{ nxt.data.title }}</strong>
              </a>
            {% else %}<span></span>{% endif %}
          </nav>
          {% endif %}

          <p style="margin-top:1.5rem"><a href="/demo/lumen-electric/blog/" style="color:var(--lu-yellow-deep);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;font-family:'Archivo',sans-serif">&larr; Back to all notes</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="lumen-section" style="background:var(--lu-bone)">
    <div class="lumen-container lumen-container--narrow">
      <span class="lumen-eyebrow">Keep reading</span>
      <h2 style="font-family:'Archivo',sans-serif;font-weight:800;color:var(--lu-black);text-transform:uppercase;letter-spacing:-0.01em;margin:0.5rem 0 1.5rem">Related notes</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem">
        {% set otherPosts = collections.lumenPost | reverse %}
        {% set shown = 0 %}
        {% for p in otherPosts %}
          {% if p.url !== page.url and shown < 3 %}
          <article style="padding:1.25rem 1.4rem;background:#FFFFFF;border:1px solid var(--lu-line)">
            <span class="lumen-eyebrow">{{ p.data.eyebrow or "Note" }}</span>
            <h3 style="font-family:'Archivo',sans-serif;font-size:1.15rem;font-weight:800;color:var(--lu-black);text-transform:uppercase;margin:0.4rem 0 0.5rem;line-height:1.25;letter-spacing:-0.01em"><a href="{{ p.url }}" style="color:inherit;text-decoration:none">{{ p.data.title }}</a></h3>
            <p style="font-size:0.92rem;color:var(--lu-gray);line-height:1.55;margin:0">{{ p.data.description | truncate(120) }}</p>
          </article>
          {% set shown = shown + 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</article>

<style>
.demo-post-toc ol li a { display:block; padding:0.4rem 0.6rem; color:var(--lu-gray); text-decoration:none; border-left:2px solid transparent; transition:color 0.15s, border-color 0.15s; line-height:1.4; }
.demo-post-toc ol li a:hover { color:var(--lu-yellow-deep); }
.demo-post-toc ol li a.is-active { color:var(--lu-black); border-left-color:var(--lu-yellow); font-weight:700; }
.demo-post-toc ol li.demo-post-toc-sub a { padding-left:1.4rem; font-size:0.86rem; }
.demo-post-toc { max-height: calc(100vh - 6rem); overflow-y: auto; padding-right: 0.25rem; }
#demoPostContent h2 { margin: 2.4rem 0 1rem; scroll-margin-top: 6rem; }
#demoPostContent h3 { margin: 2rem 0 0.75rem; scroll-margin-top: 6rem; }
#demoPostContent p { margin: 0 0 1.15em; }
#demoPostContent ul, #demoPostContent ol { margin: 0 0 1.25em 1.5em; padding: 0; }
#demoPostContent li { margin-bottom: 0.5em; line-height: 1.7; }
#demoPostContent li:last-child { margin-bottom: 0; }
#demoPostContent li p { margin: 0 0 0.6em; }
#demoPostContent blockquote { margin: 1.75rem 0; padding: 1rem 1.25rem; border-left: 3px solid var(--lu-yellow); background: var(--lu-line); }
#demoPostContent hr { margin: 2.25rem 0; }
.demo-post-share { display:flex; flex-wrap:wrap; align-items:center; gap:0.85rem 1.25rem; margin:2.5rem 0 1.5rem; padding:1.25rem 0; border-top:1px solid var(--lu-line); border-bottom:1px solid var(--lu-line); }
.demo-post-share-label { font-family:'Archivo',sans-serif; font-size:0.74rem; font-weight:800; letter-spacing:0.16em; text-transform:uppercase; color:var(--lu-gray); }
.demo-post-share-buttons { display:flex; flex-wrap:wrap; gap:0.5rem; }
.demo-post-share-btn { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; padding:0; background:transparent; border:1px solid var(--lu-line); border-radius:999px; color:var(--lu-gray); text-decoration:none; cursor:pointer; transition:background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s; }
.demo-post-share-btn:hover { background:var(--lu-yellow); border-color:var(--lu-yellow); color:var(--lu-black); transform:translateY(-1px); }
.demo-post-share-btn svg { width:16px; height:16px; fill:currentColor; }
.demo-post-share-btn .demo-post-share-icon-link, .demo-post-share-btn .demo-post-share-icon-check { fill:none; stroke:currentColor; }
.demo-post-share-btn .demo-post-share-icon-check { display:none; }
.demo-post-share-btn.is-copied .demo-post-share-icon-link { display:none; }
.demo-post-share-btn.is-copied .demo-post-share-icon-check { display:inline-block; }
.visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
@media (max-width: 900px) {
  article > section > .lumen-container > div[style*="grid-template-columns:240px"] { grid-template-columns: 1fr !important; gap: 1rem !important; }
  .demo-post-toc { display: none; }
}
</style>

{% include "partials/demo-post-script.njk" %}
