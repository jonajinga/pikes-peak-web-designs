            <div class="demo-mega-col">
              <span class="demo-mega-h5">Surrounding valley</span>
              <a href="/demo/clearwater-plumbing/service-area/#holladay" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Holladay</span><span class="demo-mega-item-desc">East-bench homes, larger remodels</span></span>
              </a>
              <a href="/demo/clearwater-plumbing/service-area/#west-valley" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
