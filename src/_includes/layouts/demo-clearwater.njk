                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M7 12h10"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Fixtures &amp; faucets</span><span class="demo-mega-item-desc">Replace anything you can buy at a hardware store</span></span>
              </a>
            </div>
