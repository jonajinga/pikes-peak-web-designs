              <a href="/demo/clearwater-plumbing/services/#water-heaters" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><circle cx="12" cy="16" r="2"/></svg></span>
