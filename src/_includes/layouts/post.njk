---
layout: layouts/base.njk
ogType: article
---

<article>
  <header class="page-hero" style="padding:clamp(3.5rem,6vw,5rem) 0 clamp(2rem,4vw,3rem)">
    <div class="container" style="max-width:var(--max-prose)">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span><a href="/blog/">Blog</a><span class="sep">/</span><span>Article</span>
      </nav>
      {% if label %}<span class="section-label">{{ label }}</span>{% endif %}
      <h1 style="max-width:32ch">{{ title }}</h1>
      <p style="font-size:0.95rem;color:rgba(255,255,255,0.7);margin-top:0.75rem">
        <span>{{ content | readingTime }}</span>
        {% if date %} &middot; <span>{{ date | dateFormat }}</span>{% endif %}
        &middot; <span>By Pikes Peak Web Designs</span>
      </p>
    </div>
  </header>

  <div class="post-content">
    {{ content | safe }}

    <div class="post-cta-box">
      <h3>Thinking about a new website?</h3>
      <p>The work is custom-coded, with nothing down and a flat $175 a month. It is built on <a href="/method/" class="inline-link">the Service Site Standard</a>, the seven principles behind every site I ship.</p>
      <a href="/contact/" class="btn btn-primary">Start a Conversation &rarr;</a>
    </div>

    <nav aria-label="Back to blog" style="margin-top:3rem;display:flex;justify-content:center">
      <a href="/blog/" class="btn btn-outline-dark">&larr; Browse all articles</a>
    </nav>
  </div>
</article>

<section class="section section--cream">
  <div class="container">
    <div class="text-center" style="margin-bottom:1.5rem">
      <span class="section-label">More articles</span>
      <h2 class="section-title" style="margin-inline:auto">Keep reading.</h2>
    </div>
    <div class="post-list">
      {% set otherPosts = collections.posts | limit(4) %}
      {% for post in otherPosts %}
        {% if post.url !== page.url %}
        <article class="post-card">
          <div class="post-meta">{{ post.data.label or "Guide" }}{% if post.date %} &middot; {{ post.date | dateFormat }}{% endif %}</div>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description }}</p>
          <a href="{{ post.url }}" class="post-link">Read article</a>
        </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
