---
layout: layouts/demo-clearwater.njk
---

{% set postUrl = 'https://pikespeakwebdesigns.com' + page.url %}
{% set postTitle = title %}

<div style="position:fixed;top:0;left:0;right:0;height:3px;background:transparent;z-index:90;pointer-events:none">
  <span id="demoPostProgressBar" style="display:block;height:100%;width:0;background:var(--cw-aqua);transition:width 0.1s linear"></span>
</div>

<article>
  <section class="clearwater-page-hero">
    <div class="clearwater-container clearwater-container--narrow">
      <nav class="clearwater-breadcrumb" aria-label="Breadcrumb">
        <a href="/demo/clearwater-plumbing/">Home</a><span class="sep">/</span><a href="/demo/clearwater-plumbing/blog/">Tips</a><span class="sep">/</span><span>Article</span>
      </nav>
      {% if eyebrow %}<span class="clearwater-eyebrow">{{ eyebrow }}</span>{% endif %}
      <h1 style="max-width:24ch">{{ title }}</h1>
      <p style="font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:0.82rem;color:rgba(255,255,255,0.78);letter-spacing:0.04em;margin-top:0.85rem">
        {% if date %}{{ date | dateFormat }}{% endif %}{% if author %} &middot; {{ author }}{% else %} &middot; Clearwater Plumbing{% endif %}{% if readingTime %} &middot; {{ readingTime }}{% endif %}
      </p>
    </div>
  </section>

  <section class="clearwater-section">
    <div class="clearwater-container" style="max-width:1100px">
      <div style="display:grid;grid-template-columns:240px 1fr;gap:3rem;align-items:start">

        <aside class="demo-post-toc" aria-label="In this article" style="position:sticky;top:5rem;align-self:start;font-family:'Inter',sans-serif">
          <span style="display:block;font-family:'DM Serif Display',Georgia,serif;font-size:1rem;font-weight:400;color:var(--cw-aqua-deep);margin-bottom:1rem">In this article</span>
          <ol id="demoPostTocList" style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.4rem;font-size:0.92rem"></ol>
        </aside>

        <div id="demoPostContent" style="line-height:1.75;color:var(--cw-text);font-size:1.05rem;min-width:0">
          {{ content | safe }}

          {% include "partials/demo-post-share.njk" %}

          <hr style="border:0;border-top:1px solid var(--cw-cream-deep);margin:2.5rem 0 2rem">

          <div style="background:var(--cw-cream);border-left:4px solid var(--cw-aqua);padding:1.5rem 1.75rem;border-radius:0 8px 8px 0">
            <span class="clearwater-eyebrow" style="margin-bottom:0.5rem">Need a plumber?</span>
            <h3 style="font-family:'Inter',sans-serif;font-size:1.4rem;font-weight:700;color:var(--cw-navy);margin:0 0 0.5rem">Honest quotes. Real availability.</h3>
            <p style="margin:0 0 1.25rem;color:var(--cw-text);line-height:1.65">Same-day for emergencies. Next-day for everything else. The visit comes with a written quote before any work starts.</p>
            <a href="/demo/clearwater-plumbing/contact/" class="clearwater-btn clearwater-btn-primary">Book service</a>
          </div>

          {% set posts = collections.clearwaterPost %}
          {% set currentIndex = -1 %}
          {% for p in posts %}{% if p.url === page.url %}{% set currentIndex = loop.index0 %}{% endif %}{% endfor %}
          {% if posts.length > 1 %}
          <nav aria-label="More articles" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:2.5rem 0 2rem">
            {% set prevIndex = currentIndex - 1 %}
            {% set nextIndex = currentIndex + 1 %}
            {% if prevIndex >= 0 %}
              {% set prev = posts[prevIndex] %}
              <a href="{{ prev.url }}" style="padding:1rem 1.15rem;background:var(--cw-cream);border:1px solid var(--cw-cream-deep);border-radius:8px;color:var(--cw-text);text-decoration:none;display:flex;flex-direction:column;gap:0.3rem">
                <span style="font-family:'Inter',sans-serif;font-size:0.72rem;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--cw-aqua-deep)">&larr; Previous</span>
                <strong style="font-family:'DM Serif Display',Georgia,serif;font-weight:400;color:var(--cw-navy);font-size:1.05rem">{{ prev.data.title }}</strong>
              </a>
            {% else %}<span></span>{% endif %}
            {% if nextIndex < posts.length %}
              {% set nxt = posts[nextIndex] %}
              <a href="{{ nxt.url }}" style="padding:1rem 1.15rem;background:var(--cw-cream);border:1px solid var(--cw-cream-deep);border-radius:8px;color:var(--cw-text);text-decoration:none;display:flex;flex-direction:column;gap:0.3rem;text-align:right">
                <span style="font-family:'Inter',sans-serif;font-size:0.72rem;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--cw-aqua-deep)">Next &rarr;</span>
                <strong style="font-family:'DM Serif Display',Georgia,serif;font-weight:400;color:var(--cw-navy);font-size:1.05rem">{{ nxt.data.title }}</strong>
              </a>
            {% else %}<span></span>{% endif %}
          </nav>
          {% endif %}

          <p style="margin-top:1.5rem"><a href="/demo/clearwater-plumbing/blog/" style="color:var(--cw-aqua-deep);font-weight:600">&larr; Back to all tips</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="clearwater-section" style="background:var(--cw-cream)">
    <div class="clearwater-container clearwater-container--narrow">
      <span class="clearwater-eyebrow">Keep reading</span>
      <h2 style="font-family:'DM Serif Display',Georgia,serif;font-weight:400;color:var(--cw-navy);font-size:2rem;margin:0.5rem 0 1.5rem">Related tips</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem">
        {% set otherPosts = collections.clearwaterPost | reverse %}
        {% set shown = 0 %}
        {% for p in otherPosts %}
          {% if p.url !== page.url and shown < 3 %}
          <article style="padding:1.25rem 1.4rem;background:#FFFFFF;border:1px solid var(--cw-cream-deep);border-radius:8px">
            <span class="clearwater-eyebrow" style="color:var(--cw-aqua-deep)">{{ p.data.eyebrow or "Tip" }}</span>
            <h3 style="font-family:'DM Serif Display',Georgia,serif;font-size:1.3rem;font-weight:400;color:var(--cw-navy);margin:0.4rem 0 0.5rem;line-height:1.25"><a href="{{ p.url }}" style="color:inherit;text-decoration:none">{{ p.data.title }}</a></h3>
            <p style="font-size:0.92rem;color:var(--cw-text);line-height:1.55;margin:0">{{ p.data.description | truncate(120) }}</p>
          </article>
          {% set shown = shown + 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</article>

<style>
.demo-post-toc ol li a { display:block; padding:0.4rem 0.6rem; color:var(--cw-text); opacity:0.7; text-decoration:none; border-left:2px solid transparent; transition:color 0.15s, opacity 0.15s, border-color 0.15s; line-height:1.4; }
.demo-post-toc ol li a:hover { color:var(--cw-aqua-deep); opacity:1; }
.demo-post-toc ol li a.is-active { color:var(--cw-aqua-deep); opacity:1; border-left-color:var(--cw-aqua); font-weight:600; }
.demo-post-toc ol li.demo-post-toc-sub a { padding-left:1.4rem; font-size:0.86rem; }
.demo-post-toc { max-height: calc(100vh - 6rem); display: flex; flex-direction: column; min-height: 0; }
.demo-post-toc > ol { overflow-y: auto; padding-right: 0.25rem; min-height: 0; flex: 1; }
#demoPostContent h2 { margin: 2.4rem 0 1rem; scroll-margin-top: 6rem; }
#demoPostContent h3 { margin: 2rem 0 0.75rem; scroll-margin-top: 6rem; }
#demoPostContent p { margin: 0 0 1.15em; }
#demoPostContent ul, #demoPostContent ol { margin: 0 0 1.25em 1.5em; padding: 0; }
#demoPostContent li { margin-bottom: 0.5em; line-height: 1.7; }
#demoPostContent li:last-child { margin-bottom: 0; }
#demoPostContent li p { margin: 0 0 0.6em; }
#demoPostContent blockquote { margin: 1.75rem 0; padding: 1rem 1.25rem; border-left: 3px solid var(--cw-aqua); background: var(--cw-cream); }
#demoPostContent hr { margin: 2.25rem 0; }
.demo-post-share { display:flex; flex-wrap:wrap; align-items:center; gap:0.85rem 1.25rem; margin:2.5rem 0 1.5rem; padding:1.25rem 0; border-top:1px solid var(--cw-cream-deep); border-bottom:1px solid var(--cw-cream-deep); }
.demo-post-share-label { font-family:'Inter',sans-serif; font-size:0.74rem; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; color:var(--cw-aqua-deep); }
.demo-post-share-buttons { display:flex; flex-wrap:wrap; gap:0.5rem; }
.demo-post-share-btn { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; padding:0; background:transparent; border:1px solid var(--cw-cream-deep); border-radius:999px; color:var(--cw-aqua-deep); text-decoration:none; cursor:pointer; transition:background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s; }
.demo-post-share-btn:hover { background:var(--cw-aqua); border-color:var(--cw-aqua); color:#FFFFFF; transform:translateY(-1px); }
.demo-post-share-btn svg { width:16px; height:16px; fill:currentColor; }
.demo-post-share-btn .demo-post-share-icon-link, .demo-post-share-btn .demo-post-share-icon-check { fill:none; stroke:currentColor; }
.demo-post-share-btn .demo-post-share-icon-check { display:none; }
.demo-post-share-btn.is-copied .demo-post-share-icon-link { display:none; }
.demo-post-share-btn.is-copied .demo-post-share-icon-check { display:inline-block; }
.visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
@media (max-width: 900px) {
  article > section > .clearwater-container > div[style*="grid-template-columns:240px"] { grid-template-columns: 1fr !important; gap: 1rem !important; }
  .demo-post-toc { display: none; }
}
</style>

{% include "partials/demo-post-script.njk" %}
