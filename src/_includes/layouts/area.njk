---
layout: layouts/base.njk
extraHead: '<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">'
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><a href="/service-areas/">Service Areas</a><span class="sep">/</span><span>{{ area.city }}, {{ area.stateCode }}</span>
    </nav>
    <span class="section-label">Serving {{ area.city }}, {{ area.stateCode }}</span>
    <h1>Custom web design for <em>{{ area.city }} service businesses.</em></h1>
    <p>Custom-coded, fast-loading websites that rank on Google and convert visitors into calls; built for service businesses across {{ area.metro }}.</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;margin-top:1.25rem">
      <span class="trust-chip">95&ndash;100 PageSpeed</span>
      <span class="trust-chip">$175/month flat</span>
      <span class="trust-chip">$0 design deposit</span>
      <span class="trust-chip">Fully remote</span>
    </div>
    <div class="cta-buttons" style="justify-content:center;margin-top:1.75rem">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a discovery call</a>
      <a href="/how-it-works/" class="btn btn-outline btn-lg">How It Works</a>
    </div>
  </div>
</section>

{% if area.lat and area.lng %}
<section class="section section--mist area-map-section">
  <div class="container" style="max-width:1180px">
    <div class="area-map-header">
      <span class="section-label">Coverage map</span>
      <h2 class="section-title">Service area for {{ area.metro }}.</h2>
      <p class="area-map-sub">Pinned: {{ area.city }} and the surrounding communities I work with most. The dashed ring is the standard remote-build coverage radius &mdash; in practice, the same site I would build for a {{ area.city }} business is the same site I build for clients across the U.S. and Canada.</p>
    </div>
    <div id="area-map" class="area-map" data-lat="{{ area.lat }}" data-lng="{{ area.lng }}" data-city="{{ area.city }}" data-metro="{{ area.metro }}" role="region" aria-label="Service-area map for {{ area.city }}, {{ area.stateCode }}"></div>
    <div class="area-map-foot">
      <span>Map &amp; tile data &copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors. Privacy-respecting, no Google Maps tracker.</span>
    </div>
    {% for community in area.nearby %}
      {% set rawKey = community | replace(" (SC)", "") | replace(" (NC)", "") | lower %}
      {% set scopedKey = rawKey + "-" + (area.stateCode | lower) %}
      {% set coord = cityCoords[scopedKey] or cityCoords[rawKey] %}
      {% if coord %}
        <span class="area-map-nearby-data" data-name="{{ community }}" data-lat="{{ coord[0] }}" data-lng="{{ coord[1] }}" hidden></span>
      {% endif %}
    {% endfor %}
  </div>
</section>
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  (function () {
    function init() {
      if (typeof L === 'undefined') return;
      var el = document.getElementById('area-map');
      if (!el || el.dataset.inited) return;
      el.dataset.inited = '1';
      var lat = parseFloat(el.dataset.lat);
      var lng = parseFloat(el.dataset.lng);
      var city = el.dataset.city;
      var metro = el.dataset.metro;
      if (!isFinite(lat) || !isFinite(lng)) return;
      var nearby = Array.prototype.map.call(
        document.querySelectorAll('.area-map-nearby-data'),
        function (n) {
          return { name: n.dataset.name, lat: parseFloat(n.dataset.lat), lng: parseFloat(n.dataset.lng) };
        }
      ).filter(function (n) { return isFinite(n.lat) && isFinite(n.lng); });

      var map = L.map(el, { center: [lat, lng], zoom: 9, scrollWheelZoom: false, zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
        maxZoom: 18
      }).addTo(map);

      var primaryIcon = L.divIcon({
        className: 'area-primary-marker',
        html: '<span class="area-primary-marker-dot"></span><span class="area-primary-marker-pulse"></span>',
        iconSize: [28, 28], iconAnchor: [14, 14]
      });
      L.marker([lat, lng], { icon: primaryIcon, zIndexOffset: 1000 }).addTo(map)
        .bindPopup('<strong>' + city + '</strong><br>' + metro + ' &middot; primary metro');

      var nearbyIcon = L.divIcon({
        className: 'area-nearby-marker',
        html: '<span class="area-nearby-marker-dot"></span>',
        iconSize: [16, 16], iconAnchor: [8, 8]
      });
      var bounds = [[lat, lng]];
      nearby.forEach(function (n) {
        L.marker([n.lat, n.lng], { icon: nearbyIcon }).addTo(map)
          .bindPopup('<strong>' + n.name + '</strong><br>Within standard ' + city + ' coverage');
        bounds.push([n.lat, n.lng]);
      });

      L.circle([lat, lng], {
        radius: 60000,
        color: '#0A1F44', weight: 1.5, opacity: 0.55,
        fillColor: '#BE9018', fillOpacity: 0.05,
        dashArray: '6,8'
      }).addTo(map).bindTooltip('Standard service radius (~37 mi)');

      function fit() {
        map.invalidateSize();
        if (bounds.length > 1) {
          map.fitBounds(bounds, { padding: [40, 40] });
        }
      }
      // Recompute on the next paint, again after the deferred stylesheet
      // is likely to have applied, and once more on full window load. The
      // first call covers the most common case; the rest are belt-and-
      // suspenders for slow connections.
      requestAnimationFrame(fit);
      setTimeout(fit, 250);
      window.addEventListener('load', fit);

      // Watch for any subsequent container size change (responsive
      // transitions, fonts loading, etc.) and re-flow the tiles.
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(function () { map.invalidateSize(); }).observe(el);
      }

      // Tap-to-enable wheel zoom; prevents accidental scroll-trap.
      map.on('click', function () { map.scrollWheelZoom.enable(); });
      map.on('mouseout', function () { map.scrollWheelZoom.disable(); });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);
  })();
</script>
{% endif %}

<section class="section">
  <div class="container">
    <div class="contact-grid" style="grid-template-columns:1.55fr 1fr">
      <div class="prose">
        <h2>The {{ area.city }} service-business market.</h2>
        <p>{{ area.marketIntro }}</p>

        <h2>Why {{ area.city }} service businesses need a strong website.</h2>
        <p>{{ area.whyWebsite }}</p>
        <p>When a homeowner in {{ area.metro }} searches for "plumber near me" or "HVAC repair {{ area.city }}" on Google, they click one of the first three results, and they call the first business that looks credible. Your website is that first impression. It earns the call or loses it.</p>

        <h2>What I build for {{ area.city }} contractors.</h2>
        <p>Every site I build for a {{ area.city }}-area business is custom-coded from scratch. No WordPress, no AI templates, no page builders. The result is a site that loads in under a second, scores 95&ndash;100 on Google PageSpeed, and is structured specifically to rank for local service searches in {{ area.metro }}.</p>
        <ul>
          <li>Custom homepage with services, service area, phone, and trust signals</li>
          <li>Dedicated service pages targeting "{{ area.city }}" + your specific services</li>
          <li>Service area pages for the suburbs and communities you cover</li>
          <li>Contact form and click-to-call phone button</li>
          <li>Google-optimized title tags, meta descriptions, and structured headings</li>
          <li>Mobile-first design; most {{ area.city }} searches are on phones</li>
          <li>Hosting, maintenance, and unlimited updates included</li>
        </ul>

        <h2>Local SEO for {{ area.city }}.</h2>
        <p>{{ area.seoInsight }}</p>
        <p>I build your site with {{ area.city }}-specific SEO from day one, not bolted on after. Your service pages use the phrases your customers actually search for, your NAP (name, address, phone) information is consistent, and your site is structured the way Google expects for local service businesses.</p>

        <h2>How I work with {{ area.city }} businesses.</h2>
        <p>I am Jon. Based in Colorado Springs, CO, and I work with service businesses across the U.S. and Canada entirely remotely. No awkward in-person meetings, no travel charges, no geographic limitations. Most sites are live within 2&ndash;3 weeks of my first call. The same person who picks up your call is the one writing your code.</p>
      </div>

      <aside style="position:sticky;top:100px;display:flex;flex-direction:column;gap:1rem">
        <div style="padding:1.75rem;background:var(--navy-900);color:var(--paper);border-radius:var(--radius-lg)">
          <span class="section-label" style="color:var(--gold-400)">Serving {{ area.city }}, {{ area.stateCode }}</span>
          <h3 style="color:var(--paper);font-size:1.2rem;margin-bottom:0.75rem">Ready for more {{ area.city }} calls?</h3>
          <p style="color:rgba(255,255,255,0.82);font-size:0.92rem;line-height:1.55;margin-bottom:1.25rem">$175/month flat rate. $0 design deposit. I build the site; you run your business.</p>
          <a href="/contact/" class="btn btn-primary btn-full" style="background:var(--gold-400);color:var(--navy-900);border-color:var(--gold-400)">Book a discovery call</a>
        </div>

        <div style="padding:1.5rem;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius)">
          <h3 style="font-family:var(--font-body);font-size:0.76rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--navy-700);margin-bottom:0.85rem">Industries in {{ area.city }}</h3>
          <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
            {% for tag in area.industries %}
              <span class="sample-tag">{{ tag | safe }}</span>
            {% endfor %}
          </div>
        </div>

        <div style="padding:1.5rem;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius)">
          <h3 style="font-family:var(--font-body);font-size:0.76rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--navy-700);margin-bottom:0.85rem">Nearby communities</h3>
          <div style="display:flex;flex-wrap:wrap;gap:0.3rem 0.5rem">
            {% for community in area.nearby %}
              <span style="font-size:0.85rem;color:var(--text-muted)">{{ community }}{% if not loop.last %},{% endif %}</span>
            {% endfor %}
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <span class="section-label">Ready to grow in {{ area.city }}?</span>
    <h2>A website built for the {{ area.city }} market.</h2>
    <p>Custom-coded, fast-loading, SEO-optimized for {{ area.city }}, {{ area.stateCode }} service searches. $175 a month, $0 down, everything included. You get me directly.</p>
    <div class="cta-buttons">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a discovery call</a>
      <a href="/service-areas/" class="btn btn-outline btn-lg">All Service Areas</a>
    </div>
  </div>
</section>
