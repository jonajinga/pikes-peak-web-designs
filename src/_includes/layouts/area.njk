---
layout: layouts/base.njk
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><a href="/service-areas/">Service Areas</a><span class="sep">/</span><span>{{ area.city }}, {{ area.stateCode }}</span>
    </nav>
    <span class="section-label">Serving {{ area.city }}, {{ area.stateCode }}</span>
    <h1>Websites for {{ area.city }} service businesses, <em>built to bring in calls</em></h1>
    <p>I build custom-coded websites for service businesses across {{ area.metro }}. They load fast, rank on Google, and turn visitors into phone calls.</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;margin-top:1.25rem">
      <span class="trust-chip">95&ndash;100 on Google's speed test</span>
      <span class="trust-chip">$175 a month, flat</span>
      <span class="trust-chip">$0 down</span>
      <span class="trust-chip">Fully remote</span>
    </div>
    <div class="cta-buttons" style="justify-content:center;margin-top:1.75rem">
      <a href="/subscribe/" class="btn btn-primary btn-lg">Start now</a>
      <a href="/how-it-works/" class="btn btn-outline btn-lg">See how it works</a>
    </div>
  </div>
</section>

{% if area.lat and area.lng %}
<section class="section section--mist area-map-section">
  <div class="container" style="max-width:1180px">
    <div class="area-map-header">
      <span class="section-label">Coverage map</span>
      <h2 class="section-title">Service area for {{ area.metro }}</h2>
      <p class="area-map-sub">The pins show {{ area.city }} and the nearby communities I serve. The dashed ring marks the standard service radius. Because I work remotely, a {{ area.city }} business gets the same site I build anywhere in the U.S. and Canada.</p>
    </div>
    <div id="area-map" class="area-map" data-lat="{{ area.lat }}" data-lng="{{ area.lng }}" data-city="{{ area.city }}" data-metro="{{ area.metro }}" role="region" aria-label="Service-area map for {{ area.city }}, {{ area.stateCode }}"></div>
    <div class="area-map-foot">
      <span>Map and tile data &copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors. This map respects your privacy, with no Google Maps tracker.</span>
    </div>
    {% for community in area.nearby %}
      {% set rawKey = community | replace(" (SC)", "") | replace(" (NC)", "") | lower %}
      {% set scopedKey = rawKey + "-" + (area.stateCode | lower) %}
      {% set coord = cityCoords[scopedKey] or cityCoords[rawKey] %}
      {% if coord %}
        <span class="area-map-nearby-data" data-name="{{ community }}" data-lat="{{ coord[0] }}" data-lng="{{ coord[1] }}" hidden></span>
      {% endif %}
    {% endfor %}
  </div>
</section>
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  (function () {
    var initAttempts = 0;
    function init() {
      if (typeof L === 'undefined') return;
      var el = document.getElementById('area-map');
      if (!el || el.dataset.inited) return;
      // Don't initialize until the container has its real height. On slow
      // connections the deferred stylesheet may not have applied yet.
      // Retry every 80ms up to ~2s before giving up.
      if (el.offsetHeight < 200 && initAttempts < 25) {
        initAttempts++;
        setTimeout(init, 80);
        return;
      }
      el.dataset.inited = '1';
      var lat = parseFloat(el.dataset.lat);
      var lng = parseFloat(el.dataset.lng);
      var city = el.dataset.city;
      var metro = el.dataset.metro;
      if (!isFinite(lat) || !isFinite(lng)) return;
      var nearby = Array.prototype.map.call(
        document.querySelectorAll('.area-map-nearby-data'),
        function (n) {
          return { name: n.dataset.name, lat: parseFloat(n.dataset.lat), lng: parseFloat(n.dataset.lng) };
        }
      ).filter(function (n) { return isFinite(n.lat) && isFinite(n.lng); });

      var map = L.map(el, { center: [lat, lng], zoom: 9, scrollWheelZoom: false, zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
        maxZoom: 18
      }).addTo(map);

      var primaryIcon = L.divIcon({
        className: 'area-primary-marker',
        html: '<span class="area-primary-marker-dot"></span><span class="area-primary-marker-pulse"></span>',
        iconSize: [28, 28], iconAnchor: [14, 14]
      });
      L.marker([lat, lng], { icon: primaryIcon, zIndexOffset: 1000 }).addTo(map)
        .bindPopup('<strong>' + city + '</strong><br>' + metro + ' &middot; primary metro');

      var nearbyIcon = L.divIcon({
        className: 'area-nearby-marker',
        html: '<span class="area-nearby-marker-dot"></span>',
        iconSize: [16, 16], iconAnchor: [8, 8]
      });
      var bounds = [[lat, lng]];
      nearby.forEach(function (n) {
        L.marker([n.lat, n.lng], { icon: nearbyIcon }).addTo(map)
          .bindPopup('<strong>' + n.name + '</strong><br>Within standard ' + city + ' coverage');
        bounds.push([n.lat, n.lng]);
      });

      L.circle([lat, lng], {
        radius: 60000,
        color: '#0A1F44', weight: 1.5, opacity: 0.55,
        fillColor: '#BE9018', fillOpacity: 0.05,
        dashArray: '6,8'
      }).addTo(map).bindTooltip('Standard service radius (~37 mi)');

      function fit() {
        map.invalidateSize();
        if (bounds.length > 1) {
          map.fitBounds(bounds, { padding: [40, 40] });
        }
      }
      // Recompute on the next paint, again after the deferred stylesheet
      // is likely to have applied, and once more on full window load. The
      // first call covers the most common case; the rest are belt-and-
      // suspenders for slow connections.
      requestAnimationFrame(fit);
      setTimeout(fit, 250);
      window.addEventListener('load', fit);

      // Watch for any subsequent container size change (responsive
      // transitions, fonts loading, etc.) and re-flow the tiles.
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(function () { map.invalidateSize(); }).observe(el);
      }

      // Tap-to-enable wheel zoom; prevents accidental scroll-trap.
      map.on('click', function () { map.scrollWheelZoom.enable(); });
      map.on('mouseout', function () { map.scrollWheelZoom.disable(); });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);
  })();
</script>
{% endif %}

<section class="section">
  <div class="container">
    <div class="contact-grid" style="grid-template-columns:1.55fr 1fr">
      <div class="prose">
        <h2>The {{ area.city }} service-business market</h2>
        <p>{{ area.marketIntro }}</p>

        <h2>Why a strong website matters in {{ area.city }}</h2>
        <p>{{ area.whyWebsite }}</p>
        <p>When a homeowner in {{ area.metro }} searches Google for "plumber near me" or "HVAC repair {{ area.city }}," they click one of the first three results and call the first business that looks credible. Your website is that first impression, and it wins or loses the call.</p>

        <h2>What I build for {{ area.city }} contractors</h2>
        <p>Every site I build for a {{ area.city }}-area business is custom-coded: I write it from scratch instead of filling in a template. It loads in under a second, scores 95&ndash;100 on Google's speed test, and is built to rank in local service searches across {{ area.metro }}.</p>
        <ul>
          <li>A custom home page with your services, service area, phone, and credentials</li>
          <li>A page for each service, written for "{{ area.city }}" searches</li>
          <li>Pages for the suburbs and communities you cover</li>
          <li>A contact form and a tap-to-call phone button</li>
          <li>Page titles, search descriptions, and headings written for Google</li>
          <li>A design built for phones, where most {{ area.city }} searches happen</li>
          <li>Hosting, maintenance, and unlimited updates, all included</li>
        </ul>

        <h2>Showing up in {{ area.city }} searches</h2>
        <p>{{ area.seoInsight }}</p>
        <p>I build your site for {{ area.city }} searches (local SEO) from the first day. Your service pages use the words your customers search for. Your name, address, and phone number (your "NAP") match everywhere, and the site is laid out the way Google expects of a local service business.</p>

        <h2>How I work with {{ area.city }} businesses</h2>
        <p>I'm Jon, and I work from Colorado Springs, Colorado, with businesses across the U.S. and Canada. Everything happens by phone, email, and video, so you pay no travel charges. Most sites go live two to three weeks after your first payment clears, and the person who answers your call writes your code.</p>

        {% if area.localContext %}
        <h2>What sets {{ area.city }} apart</h2>
        <p>{{ area.localContext }}</p>
        {% endif %}

        {% if area.localFaq and area.localFaq.length %}
        <h2>Common questions about web design in {{ area.city }}</h2>
        <div class="faq-list" style="margin-top:1.25rem">
          {% for item in area.localFaq %}
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false"><span>{{ item.q }}</span> <span class="faq-icon" aria-hidden="true"></span></button>
            <div class="faq-answer"><div class="faq-answer-inner">{{ item.a }}</div></div>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if site.blogPublic and area.relatedPosts and area.relatedPosts.length %}
        <h2>More on local search in {{ area.city }}</h2>
        <div class="post-list" style="margin-top:1.25rem">
          {% for slug in area.relatedPosts %}
            {% set targetUrl = "/blog/" + slug + "/" %}
            {% set match = false %}
            {% for post in collections.posts %}
              {% if post.url == targetUrl %}{% set match = post %}{% endif %}
            {% endfor %}
            {% if match %}
            <article class="post-card">
              <div class="post-meta">{{ match.data.label or "Guide" }}</div>
              <h3><a href="{{ match.url }}">{{ match.data.title }}</a></h3>
              <p>{{ match.data.description }}</p>
              <a href="{{ match.url }}" class="post-link">Read article</a>
            </article>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <aside style="position:sticky;top:100px;display:flex;flex-direction:column;gap:1rem">
        <div style="padding:1.75rem;background:var(--navy-900);color:var(--paper);border-radius:var(--radius-lg)">
          <span class="section-label" style="color:var(--gold-400)">Serving {{ area.city }}, {{ area.stateCode }}</span>
          <h3 style="color:var(--paper);font-size:1.2rem;margin-bottom:0.75rem">Want more work in {{ area.city }}?</h3>
          <p style="color:rgba(255,255,255,0.82);font-size:0.92rem;line-height:1.55;margin-bottom:1.25rem">$175 a month, $0 down. I build the site, and you run your business. The free call takes 20 to 30 minutes on Google Meet.</p>
          <a href="/contact/" class="btn btn-primary btn-full" style="background:var(--gold-400);color:var(--navy-900);border-color:var(--gold-400)">Book a free call</a>
        </div>

        <div style="padding:1.5rem;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius)">
          <h3 style="font-family:var(--font-body);font-size:0.76rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--navy-700);margin-bottom:0.85rem">Industries in {{ area.city }}</h3>
          <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
            {% for tag in area.industries %}
              <span class="sample-tag">{{ tag | safe }}</span>
            {% endfor %}
          </div>
        </div>

        <div style="padding:1.5rem;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius)">
          <h3 style="font-family:var(--font-body);font-size:0.76rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--navy-700);margin-bottom:0.85rem">Nearby communities</h3>
          <div style="display:flex;flex-wrap:wrap;gap:0.3rem 0.5rem">
            {% for community in area.nearby %}
              <span style="font-size:0.85rem;color:var(--text-muted)">{{ community }}{% if not loop.last %},{% endif %}</span>
            {% endfor %}
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <span class="section-label">Ready to grow in {{ area.city }}?</span>
    <h2>A website built for the {{ area.city }} market</h2>
    <p>You get a custom-coded, fast site built to rank in {{ area.city }}, {{ area.stateCode }} searches, for $175 a month with $0 down. Everything is included, and you work with me directly.</p>
    <div class="cta-buttons">
      <a href="/subscribe/" class="btn btn-primary btn-lg">Start now</a>
    </div>
    <p class="cta-sub"><a href="/contact/">Prefer to talk first? Book a free call</a></p>
  </div>
</section>
