<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#082F49">
  <title>{{ title if title else "Summit HVAC | Denver Heating &amp; Cooling Engineers" }}</title>
  <meta name="description" content="{{ description if description else 'Engineering-grade heating and cooling for Denver metro homes. Heat-load calculations, properly sized systems, SEER2-rated equipment. Licensed, bonded, insured.' }}">
  <link rel="canonical" href="https://pikespeakwebdesigns.com/samples/">
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="https://fonts.bunny.net/space-grotesk/files/space-grotesk-latin-600-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="https://fonts.bunny.net/inter/files/inter-latin-400-normal.woff2" crossorigin>
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=space-grotesk:500,600,700|inter:400,500,600|jetbrains-mono:400,500&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.bunny.net/css?family=space-grotesk:500,600,700|inter:400,500,600|jetbrains-mono:400,500&display=swap"></noscript>
  <link rel="icon" type="image/svg+xml" href="/assets/img/demo-favicons/summit.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/demo-favicons/summit.svg">
  <link rel="stylesheet" href="/assets/css/summit.css">
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body class="summit-site">

<div class="summit-banner" role="note" aria-label="Demo site notice">
  <span class="summit-banner-label">Live Demo &middot; Pikes Peak Web Designs</span>
  <div class="summit-banner-actions">
    <a href="/samples/">&larr; Samples</a>
    <a href="/contact/">Get a site like this &rarr;</a>
  </div>
</div>

<header class="summit-header">
  <div class="summit-header-inner">
    <a href="/demo/summit-hvac/" class="summit-logo">
      <span class="summit-logo-mark">S</span>
      <span>Summit <span class="summit-logo-accent">HVAC</span></span>
    </a>
    <nav class="summit-nav" aria-label="Main navigation">
      <a href="/demo/summit-hvac/"{% if page.url == '/demo/summit-hvac/' %} class="is-active"{% endif %}>Overview</a>

      <div class="demo-mega-dropdown">
        <a href="/demo/summit-hvac/services/"{% if page.url | startsWith('/demo/summit-hvac/services/') %} class="is-active"{% endif %}>Services <span class="demo-mega-chevron" aria-hidden="true"></span></a>
        <div class="demo-mega" role="menu" aria-label="HVAC services menu">
          <div class="demo-mega-inner">
            <div class="demo-mega-col">
              <span class="demo-mega-h5">Heating &amp; cooling</span>
              <a href="/demo/summit-hvac/services/#installs" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Heat pump installs</span><span class="demo-mega-item-desc">Cold-climate-rated, Manual J sized</span></span>
              </a>
              <a href="/demo/summit-hvac/services/#ac" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 12h18M9 6v12M15 6v12"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">AC installation</span><span class="demo-mega-item-desc">SEER2-rated equipment, refrigerant handling on site</span></span>
              </a>
              <a href="/demo/summit-hvac/services/#furnace" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8 6 8 9 12 12s4 6 0 10"/><path d="M16 6c-2 2-2 4 0 6"/><path d="M8 6c2 2 2 4 0 6"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Furnace repair &amp; replace</span><span class="demo-mega-item-desc">Same-day diagnosis on no-heat calls</span></span>
              </a>
            </div>
            <div class="demo-mega-col">
              <span class="demo-mega-h5">Indoor environment</span>
              <a href="/demo/summit-hvac/services/#air" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h13a3 3 0 100-6"/><path d="M3 16h11a3 3 0 110 6"/><path d="M3 12h17a3 3 0 100-6"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Indoor air quality</span><span class="demo-mega-item-desc">HRV, ERV, MERV-13 filtration upgrades</span></span>
              </a>
              <a href="/demo/summit-hvac/services/#maintenance" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3l-1-1L4 15v5h5l9.7-9.7-1-1"/><path d="M16 4l4 4"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Maintenance plans</span><span class="demo-mega-item-desc">Two visits a year, priority service all year</span></span>
              </a>
              <a href="/demo/summit-hvac/services/#manual-j" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Heat-load calculations</span><span class="demo-mega-item-desc">Manual J on every install &mdash; no rule-of-thumb sizing</span></span>
              </a>
            </div>
            <aside class="demo-mega-feature" style="--demo-mega-feature-from:#082F49;--demo-mega-feature-to:#031621;--demo-mega-feature-eyebrow:#06B6D4;--demo-mega-feature-cta-bg:#06B6D4;--demo-mega-feature-cta-color:#031621;">
              <span class="demo-mega-feature-eyebrow">Engineering-grade</span>
              <h3 class="demo-mega-feature-title">Properly sized systems, every time.</h3>
              <p class="demo-mega-feature-body">Manual J load calculation on every install &mdash; the same level of rigor commercial engineers expect.</p>
              <a href="/demo/summit-hvac/contact/" class="demo-mega-feature-cta">Request estimate &rarr;</a>
            </aside>
          </div>
        </div>
      </div>

      <div class="demo-mega-dropdown">
        <a href="/demo/summit-hvac/service-area/"{% if page.url | startsWith('/demo/summit-hvac/service-area/') %} class="is-active"{% endif %}>Service Area <span class="demo-mega-chevron" aria-hidden="true"></span></a>
        <div class="demo-mega" role="menu" aria-label="Service area menu">
          <div class="demo-mega-inner">
            <div class="demo-mega-col">
              <span class="demo-mega-h5">Denver core</span>
              <a href="/demo/summit-hvac/service-area/#denver" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Denver</span><span class="demo-mega-item-desc">All neighborhoods inside the I-25/I-225 loop</span></span>
              </a>
              <a href="/demo/summit-hvac/service-area/#aurora" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Aurora</span><span class="demo-mega-item-desc">Older single-families east of I-225</span></span>
              </a>
              <a href="/demo/summit-hvac/service-area/#lakewood" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Lakewood</span><span class="demo-mega-item-desc">Foothills proximity, mixed-vintage homes</span></span>
              </a>
            </div>
            <div class="demo-mega-col">
              <span class="demo-mega-h5">South metro</span>
              <a href="/demo/summit-hvac/service-area/#centennial" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Centennial</span><span class="demo-mega-item-desc">Full coverage south of E-470</span></span>
              </a>
              <a href="/demo/summit-hvac/service-area/#highlands-ranch" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Highlands Ranch</span><span class="demo-mega-item-desc">Newer subdivisions, builder-grade upgrades</span></span>
              </a>
              <a href="/demo/summit-hvac/service-area/#englewood" class="demo-mega-item" role="menuitem">
                <span class="demo-mega-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                <span class="demo-mega-item-body"><span class="demo-mega-item-title">Englewood &amp; Littleton</span><span class="demo-mega-item-desc">Older bungalows, full ductwork rebuilds</span></span>
              </a>
            </div>
            <aside class="demo-mega-feature" style="--demo-mega-feature-from:#0F2740;--demo-mega-feature-to:#06121E;--demo-mega-feature-eyebrow:#06B6D4;--demo-mega-feature-cta-bg:#FFFFFF;--demo-mega-feature-cta-color:#082F49;">
              <span class="demo-mega-feature-eyebrow">Five-county coverage</span>
              <h3 class="demo-mega-feature-title">From Boulder down to Castle Rock.</h3>
              <p class="demo-mega-feature-body">Two trucks running daily across the metro &mdash; same-day estimates inside our primary zone.</p>
              <a href="/demo/summit-hvac/service-area/" class="demo-mega-feature-cta">See full coverage &rarr;</a>
            </aside>
          </div>
        </div>
      </div>

      <a href="/demo/summit-hvac/about/"{% if page.url | startsWith('/demo/summit-hvac/about/') %} class="is-active"{% endif %}>About</a>
      <a href="/demo/summit-hvac/pricing/"{% if page.url | startsWith('/demo/summit-hvac/pricing/') %} class="is-active"{% endif %}>Pricing</a>
      <a href="/demo/summit-hvac/blog/"{% if page.url | startsWith('/demo/summit-hvac/blog/') %} class="is-active"{% endif %}>Resources</a>
      <a href="tel:9283159094" class="summit-nav-phone">(928) 315-9094</a>
      <a href="/demo/summit-hvac/contact/" class="summit-nav-cta">Request estimate</a>
    </nav>
    <button class="summit-menu-toggle" type="button" aria-label="Toggle menu" onclick="document.getElementById('summitMobileNav').classList.toggle('is-open')">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<div class="summit-mobile-nav" id="summitMobileNav">
  <button class="summit-mobile-nav-close" type="button" aria-label="Close menu" onclick="document.getElementById('summitMobileNav').classList.remove('is-open')">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <a href="tel:9283159094">Call (928) 315-9094</a>
  <a href="/demo/summit-hvac/">Overview</a>
  <a href="/demo/summit-hvac/services/">Services</a>
  <a href="/demo/summit-hvac/service-area/">Service Area</a>
  <a href="/demo/summit-hvac/about/">About</a>
  <a href="/demo/summit-hvac/pricing/">Pricing</a>
  <a href="/demo/summit-hvac/blog/">Resources</a>
  <a href="/demo/summit-hvac/contact/">Request estimate</a>
</div>

<main id="main-content">
  {{ content | safe }}
</main>

<footer class="summit-footer">
  <div class="summit-footer-grid">
    <div class="summit-footer-brand">
      <div class="summit-logo" style="color:#FFFFFF">
        <span class="summit-logo-mark" style="background:var(--su-cyan);color:var(--su-navy-deep)">S</span>
        <span>Summit <span class="summit-logo-accent">HVAC</span></span>
      </div>
      <p>Engineering-grade heating, cooling, and ventilation for Denver metro homes. Manual J heat-load calculations on every install. Licensed, bonded, insured.</p>
    </div>
    <div>
      <h3 class="summit-footer-col-title">Services</h3>
      <a href="/demo/summit-hvac/services/#installs">Heat pump installs</a>
      <a href="/demo/summit-hvac/services/#ac">AC installation</a>
      <a href="/demo/summit-hvac/services/#furnace">Furnace repair</a>
      <a href="/demo/summit-hvac/services/#air">Indoor air quality</a>
      <a href="/demo/summit-hvac/services/#maintenance">Maintenance plans</a>
    </div>
    <div>
      <h3 class="summit-footer-col-title">Company</h3>
      <a href="/demo/summit-hvac/about/">About</a>
      <a href="/demo/summit-hvac/services/">Services</a>
      <a href="/demo/summit-hvac/contact/">Request estimate</a>
    </div>
    <div>
      <h3 class="summit-footer-col-title">Contact</h3>
      <a href="tel:9283159094">(928) 315-9094</a>
      <a href="mailto:service@summithvac.example">service@summithvac.example</a>
      <a href="#">1208 Santa Fe Dr, Denver, CO 80204</a>
    </div>
  </div>
  <div class="summit-footer-bottom">
    <span>&copy; {{ "" | currentYear }} Summit HVAC &middot; License CO-MP-2215</span>
    <span>
      <a href="/demo/summit-hvac/privacy-policy/">Privacy</a> &middot;
      <a href="/demo/summit-hvac/terms-of-use/">Terms</a> &middot;
      <a href="/demo/summit-hvac/accessibility/">Accessibility</a> &middot;
      <a href="/demo/summit-hvac/sitemap/">Sitemap</a> &middot;
      <a href="/demo/summit-hvac/style-guide/">Brand</a> &middot;
      Site by <a href="https://pikespeakwebdesigns.com/" class="summit-footer-pp" rel="noopener">Pikes Peak Web Designs</a>
