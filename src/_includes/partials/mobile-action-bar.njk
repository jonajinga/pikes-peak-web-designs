{#- Phone-only action bar: "Start now" plus tap-to-call. main.js shows it
    once the page's top section scrolls away and hides it again while a
    closing call to action or the footer is on screen, or while a form
    field has focus. Left off pages whose main job is a form. -#}
{%- set _u = page.url or "" -%}
{%- if not (_u | startsWith('/contact/') or _u | startsWith('/ask/') or _u | startsWith('/subscribe/')
    or _u | startsWith('/onboarding/') or _u | startsWith('/content-update/') or _u | startsWith('/design-feedback/')
    or _u | startsWith('/emergency/') or _u | startsWith('/hourly-request/') or _u | startsWith('/refer/')
    or _u | startsWith('/testimonial/') or _u | startsWith('/thank-you/') or _u | startsWith('/client-portal/')
    or (_u | startsWith('/sample-forms/') and _u != '/sample-forms/')) %}
<div class="action-bar" data-action-bar>
  <a href="/subscribe/" class="action-bar-btn action-bar-btn--primary">Start now</a>
  <a href="tel:{{ site.phone }}" class="action-bar-btn action-bar-btn--call">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span><span class="visually-hidden">Call </span>{{ site.phoneDisplay }}</span>
  </a>
</div>
{%- endif %}
