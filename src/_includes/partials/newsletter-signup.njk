<div class="newsletter-signup" role="region" aria-label="Newsletter signup">
  <div class="newsletter-signup-inner">
    <span class="newsletter-signup-eyebrow">The Service Site Letter</span>
    <h3 class="newsletter-signup-title">One short note, every other Tuesday.</h3>
    <p class="newsletter-signup-sub">A practical observation on local SEO, page speed, or a service-business website pattern &mdash; whatever I noticed in the work that week. Plus one thing I shipped, plus one ask. Three sections, never longer than 250 words. Unsubscribe in one click.</p>
    <form action="https://buttondown.com/api/emails/embed-subscribe/pikespeakwebdesigns" method="post" target="popupwindow" class="newsletter-form">
      <div class="newsletter-form-row">
        <label for="bd-email" class="visually-hidden">Email address</label>
        <input type="email" name="email" id="bd-email" placeholder="you@example.com" required autocomplete="email">
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </div>
      <p class="newsletter-form-hint">No spam, no upsells, no AI-generated filler. <strong>{{ site.voice.signoff }}</strong></p>
    </form>
  </div>
</div>
