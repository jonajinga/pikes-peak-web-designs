<style>
/* Inlined critical CSS: theme tokens + above-the-fold layout primitives.
   The full style.css is deferred via media=print onload below; this prevents
   FOUC during the brief window before the full sheet applies. ~3KB minified. */
:root,:root[data-theme="light"]{--bg:#FFFFFF;--bg-alt:#FBF7EE;--bg-alt-2:#F1F4FA;--surface:#FFFFFF;--surface-raised:#FFFFFF;--navy-950:#05102A;--navy-900:#0A1F44;--navy-800:#10295A;--navy-700:#1B3C7E;--gold-300:#EBCD6D;--gold-400:#DDB13D;--gold-500:#BE9018;--gold-600:#926C10;--text:#10172A;--text-muted:#4A5463;--text-soft:#64707E;--line:#DFE3EB;--line-strong:#C1C7D3;--header-bg:rgba(255,255,255,0.92);--font-body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;--font-display:'Playfair Display','Source Serif 4',Georgia,serif;--max-width:1280px;--max-prose:72ch;--radius:8px;--radius-sm:4px;--radius-lg:14px}
:root[data-theme="dark"]{--bg:#071125;--bg-alt:#0B1930;--bg-alt-2:#0D1B35;--surface:#0D1B35;--surface-raised:#132546;--text:#E5E8F0;--text-muted:#9DA8BD;--text-soft:#7A8499;--line:#1E2B47;--line-strong:#2C3D60;--gold-500:#DDB13D;--gold-600:#EBCD6D;--header-bg:rgba(11,25,48,0.92)}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;scroll-behavior:smooth}
html,body{margin:0;padding:0}
body{min-height:100vh;background:var(--bg);color:var(--text);font-family:var(--font-body);font-size:1rem;line-height:1.6;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img,svg,picture{display:block;max-width:100%;height:auto}
a{color:var(--link,var(--navy-800));text-decoration:none}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
h1,h2,h3,h4{font-family:var(--font-display);font-weight:600;line-height:1.15;margin:0 0 1rem;color:var(--text)}
.container{max-width:var(--max-width);margin:0 auto;padding:0 clamp(1.25rem,3vw,2rem)}
.skip-link{position:absolute;left:-9999px;top:0;background:var(--navy-900);color:#fff;padding:0.75rem 1rem;z-index:9999}
.skip-link:focus{left:0}
.topbar{background:var(--navy-950);color:#fff;font-size:0.85rem;padding:0.5rem 0}
.header{position:sticky;top:0;z-index:100;background:var(--header-bg);backdrop-filter:saturate(140%) blur(8px);-webkit-backdrop-filter:saturate(140%) blur(8px);border-bottom:1px solid var(--line)}
.header-inner{max-width:var(--max-width);margin:0 auto;padding:0.85rem clamp(1.25rem,3vw,2rem);display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
.logo{font-family:var(--font-display);font-size:1.4rem;font-weight:700;color:var(--text);display:inline-flex;align-items:baseline;gap:0.35rem;line-height:1;white-space:nowrap;text-decoration:none}
.nav-links{display:flex;align-items:center;gap:0.15rem}
.nav-links>a:not(.btn),.nav-dropdown>a{padding:0.6rem 0.85rem;font-size:0.92rem;font-weight:500;color:var(--text);border-radius:var(--radius-sm);white-space:nowrap;position:relative}
.nav-icon-btn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:var(--radius-sm);color:var(--text)}
.nav-dropdown{position:relative}
.mega-menu{display:none;visibility:hidden;opacity:0;position:fixed;top:-9999px;left:-9999px}
.hamburger{display:inline-flex;flex-direction:column;justify-content:center;align-items:center;width:44px;height:44px;padding:10px;gap:5px;border-radius:var(--radius-sm)}
.hamburger span{display:block;width:22px;height:2px;background:var(--text);border-radius:2px}
@media (max-width:980px){.nav-links{display:none}}
.hero,.page-hero{padding:clamp(2.5rem,6vw,5rem) 0 clamp(2.5rem,5vw,4rem);background:var(--bg)}
.hero h1{font-size:clamp(2.25rem,1.65rem+3vw,3.5rem)}
.page-hero h1{font-size:clamp(2rem,1.5rem+2.5vw,3rem)}
.section{padding:clamp(3rem,6vw,5rem) 0}
.btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.25rem;border-radius:var(--radius);font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer;font-size:0.95rem}
.btn-primary{background:var(--navy-900);color:#fff;border-color:var(--navy-900)}
.back-to-top{position:fixed;right:1.25rem;bottom:1.25rem;width:44px;height:44px;border-radius:50%;background:var(--navy-900);color:#fff;display:none;align-items:center;justify-content:center;z-index:90}
/* Mobile nav must be off-screen from first paint. Without this rule in the
   critical block, the .mobile-nav panel briefly renders flush-right (visible)
   before the deferred stylesheet's transform: translateX(100%) applies,
   producing a one-frame flash on every page load. Demo mobile-navs are not
   affected because their per-demo CSS bundles load synchronously. */
.mobile-nav{position:fixed;top:0;right:0;bottom:0;width:min(400px,92vw);transform:translateX(100%);z-index:105}
.mobile-nav.open{transform:translateX(0)}
.mobile-backdrop{position:fixed;inset:0;opacity:0;visibility:hidden;z-index:104}
/* Service-area Leaflet map container needs a deterministic height before
   Leaflet initializes; otherwise it computes tiles against a 0-px
   container and the rendered map ends up as a few stray tiles in a tall
   empty box once the deferred stylesheet swaps in. */
.area-map{height:clamp(360px,50vh,540px);border-radius:14px;overflow:hidden;position:relative;z-index:0;background:#F1F4FA}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}}
</style>
