<style>
/* Self-hosted Inter + Playfair Display Latin subsets. Same-origin, no
   third-party DNS/TLS round-trip. font-display: swap renders the
   fallback metrics-matched face below immediately, so when the real
   woff2 loads there is zero layout shift on swap. */
@font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url('/assets/fonts/inter-latin-400.woff2') format('woff2')}
@font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('/assets/fonts/inter-latin-500.woff2') format('woff2')}
@font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url('/assets/fonts/inter-latin-600.woff2') format('woff2')}
@font-face{font-family:'Inter';font-style:normal;font-weight:700;font-display:swap;src:url('/assets/fonts/inter-latin-700.woff2') format('woff2')}
@font-face{font-family:'Playfair Display';font-style:normal;font-weight:400;font-display:swap;src:url('/assets/fonts/playfair-display-latin-400.woff2') format('woff2')}
@font-face{font-family:'Playfair Display';font-style:normal;font-weight:500;font-display:swap;src:url('/assets/fonts/playfair-display-latin-500.woff2') format('woff2')}
@font-face{font-family:'Playfair Display';font-style:normal;font-weight:600;font-display:swap;src:url('/assets/fonts/playfair-display-latin-600.woff2') format('woff2')}
@font-face{font-family:'Playfair Display';font-style:normal;font-weight:700;font-display:swap;src:url('/assets/fonts/playfair-display-latin-700.woff2') format('woff2')}
/* Metrics-matched fallback faces. Browser uses these (with size-adjust
   tuned to the real font's metrics) until the real woff2 swaps in, so
   the swap is invisible and no CLS — no header shift on theme toggle
   or cold cache. Numbers from Google's font-fallback metrics tool. */
@font-face{font-family:'InterFallback';src:local('Arial');size-adjust:107.4%;ascent-override:90.49%;descent-override:22.51%;line-gap-override:0%}
@font-face{font-family:'PlayfairFallback';src:local('Georgia');size-adjust:110%;ascent-override:96.13%;descent-override:24.04%;line-gap-override:0%}
:root,:root[data-theme="light"]{--bg:#FFFFFF;--bg-alt:#FBF7EE;--bg-alt-2:#F1F4FA;--surface:#FFFFFF;--surface-raised:#FFFFFF;--navy-950:#05102A;--navy-900:#0A1F44;--navy-800:#10295A;--navy-700:#1B3C7E;--gold-300:#EBCD6D;--gold-400:#DDB13D;--gold-500:#BE9018;--gold-600:#926C10;--text:#10172A;--text-muted:#4A5463;--text-soft:#64707E;--line:#DFE3EB;--line-strong:#C1C7D3;--header-bg:rgba(255,255,255,0.92);--font-body:'Inter','InterFallback',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;--font-display:'Playfair Display','PlayfairFallback','Source Serif 4',Georgia,serif;--max-width:1280px;--max-prose:72ch;--radius:8px;--radius-sm:4px;--radius-lg:14px}
:root[data-theme="dark"]{--bg:#071125;--bg-alt:#0B1930;--bg-alt-2:#0D1B35;--surface:#0D1B35;--surface-raised:#132546;--text:#E5E8F0;--text-muted:#9DA8BD;--text-soft:#7A8499;--line:#1E2B47;--line-strong:#2C3D60;--gold-500:#DDB13D;--gold-600:#EBCD6D;--header-bg:rgba(11,25,48,0.92)}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;scroll-behavior:smooth;background:var(--bg);color:var(--text)}
html,body{margin:0;padding:0}
body{min-height:100vh;background:var(--bg);color:var(--text);font-family:var(--font-body);font-size:1rem;line-height:1.6;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
img,svg,picture{display:block;max-width:100%;height:auto}
a{color:var(--link,var(--navy-800));text-decoration:none}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
h1,h2,h3,h4{font-family:var(--font-display);font-weight:600;line-height:1.15;margin:0 0 1rem;color:var(--text)}
.container{max-width:var(--max-width);margin:0 auto;padding:0 clamp(1.25rem,3vw,2rem)}
.skip-link{position:absolute;left:-9999px;top:0;background:var(--navy-900);color:#fff;padding:0.75rem 1rem;z-index:9999}
.skip-link:focus{left:0}
.topbar{background:var(--navy-950);color:#DDE3EE;font-size:0.82rem;padding:0;border-bottom:1px solid rgba(255,255,255,0.06)}
.topbar-inner{max-width:var(--max-width);margin:0 auto;padding:0.6rem clamp(1.25rem,3vw,2rem);display:flex;align-items:center;justify-content:space-between;gap:1.5rem;white-space:nowrap}
.topbar-left,.topbar-center,.topbar-right{flex:0 0 auto;white-space:nowrap}
.topbar-center{font-family:var(--font-display);font-style:italic;color:#B8C0CF;margin:0 auto}
.topbar-right{display:flex;align-items:center;gap:1rem}
.topbar-right a{color:inherit;font-weight:500}
.topbar-sep{color:#8993A8}
.topbar-portal{color:var(--gold-300);font-weight:600}
.header{position:sticky;top:0;z-index:100;background:var(--header-bg);backdrop-filter:saturate(140%) blur(8px);-webkit-backdrop-filter:saturate(140%) blur(8px);border-bottom:1px solid var(--line)}
.header-inner{max-width:var(--max-width);margin:0 auto;padding:0 clamp(1.25rem,3vw,2rem);height:72px;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
.logo{font-family:var(--font-display);font-size:1.4rem;font-weight:700;color:var(--text);display:inline-flex;align-items:baseline;gap:0.35rem;line-height:1;white-space:nowrap;text-decoration:none}
.nav-links{display:flex;align-items:center;gap:0.15rem}
.nav-links>a:not(.btn),.nav-dropdown>a{padding:0.6rem 0.85rem;font-size:0.92rem;font-weight:500;color:var(--text);border-radius:var(--radius-sm);white-space:nowrap;position:relative}
.nav-icon-btn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:var(--radius-sm);color:var(--text)}
.nav-dropdown{position:relative}
.mega-menu{display:none;visibility:hidden;opacity:0;position:fixed;top:-9999px;left:-9999px}
.hamburger{display:inline-flex;flex-direction:column;justify-content:center;align-items:center;width:44px;height:44px;padding:10px;gap:5px;border-radius:var(--radius-sm)}
.hamburger span{display:block;width:22px;height:2px;background:var(--text);border-radius:2px}
@media (max-width:980px){.nav-links{display:none}}
.hero{padding:clamp(2.5rem,6vw,5rem) 0 clamp(2.5rem,5vw,4rem);background:var(--bg)}
.hero h1{font-size:clamp(2.25rem,1.65rem+3vw,3.5rem)}
.page-hero{background:linear-gradient(180deg,var(--navy-950) 0%,var(--navy-900) 100%);color:#fff;padding:clamp(4rem,7vw,6rem) 0 clamp(4rem,6vw,5rem);text-align:center;position:relative;overflow:hidden;isolation:isolate}
.page-hero h1{font-size:clamp(2rem,1.5rem+2.5vw,3rem);color:#fff;margin:0 0 1rem}
.page-hero h1 em{font-style:italic;color:var(--gold-400)}
.page-hero p{color:rgba(255,255,255,0.85);font-size:1.05rem;line-height:1.6;max-width:64ch;margin:0 auto}
.page-hero .section-label{color:var(--gold-400);display:inline-block;font-size:0.74rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:1rem}
.page-hero .breadcrumb{display:flex;width:100%;font-size:0.85rem;color:rgba(255,255,255,0.62);margin-bottom:1.25rem;gap:0.4rem;align-items:center;flex-wrap:wrap;justify-content:center}
.page-hero .breadcrumb a{color:rgba(255,255,255,0.78)}
.page-hero .breadcrumb .sep{color:rgba(255,255,255,0.4)}
.section{padding:clamp(3rem,6vw,5rem) 0}
.proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.5rem}
@media(max-width:880px){.proof-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.proof-grid{grid-template-columns:1fr}}
.proof-card{display:block;padding:1.25rem 1.4rem;background:var(--surface-raised);border:1px solid var(--line);border-left:3px solid var(--gold-500);border-radius:0 var(--radius) var(--radius) 0;text-decoration:none;color:var(--text)}
.proof-card .proof-num{display:inline-block;font-family:var(--font-display);font-size:1.6rem;font-weight:700;color:var(--navy-900);line-height:1;margin-bottom:0.5rem}
.proof-card strong{display:block;font-size:0.98rem;font-weight:600;margin-bottom:0.4rem;color:var(--text)}
.proof-card span:not(.proof-num){display:block;font-size:0.86rem;color:var(--text-muted);line-height:1.5}
.btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.25rem;border-radius:var(--radius);font-weight:600;text-decoration:none;border:1px solid transparent;cursor:pointer;font-size:0.95rem}
.btn-primary{background:var(--navy-900);color:#fff;border-color:var(--navy-900)}
.btn-outline{background:transparent;color:#fff;border-color:rgba(255,255,255,0.45)}
.btn-outline-dark{background:transparent;color:var(--navy-900);border-color:var(--navy-900)}
.btn-lg{padding:0.95rem 1.6rem;font-size:1rem}
.cta-buttons{display:flex;justify-content:center;flex-wrap:wrap;gap:0.75rem;margin-bottom:1.75rem}
.hero-trust{display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;margin-top:1.25rem}
.trust-chip{display:inline-flex;align-items:center;gap:0.4rem;padding:0.4rem 0.85rem;font-size:0.8rem;font-weight:500;color:rgba(255,255,255,0.88);background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:999px}
.trust-chip::before{content:'';width:6px;height:6px;background:var(--gold-400);border-radius:50%;flex-shrink:0}
.back-to-top{position:fixed;right:1.25rem;bottom:1.25rem;width:44px;height:44px;border-radius:50%;background:var(--navy-900);color:#fff;display:none;align-items:center;justify-content:center;z-index:90}
/* Mobile nav must be off-screen from first paint. Without this rule in the
   critical block, the .mobile-nav panel briefly renders flush-right (visible)
   before the deferred stylesheet's transform: translateX(100%) applies,
   producing a one-frame flash on every page load. Demo mobile-navs are not
   affected because their per-demo CSS bundles load synchronously. */
.mobile-nav{position:fixed;top:0;right:0;bottom:0;width:min(400px,92vw);transform:translateX(100%);z-index:105}
.mobile-nav.open{transform:translateX(0)}
.mobile-backdrop{position:fixed;inset:0;opacity:0;visibility:hidden;z-index:104}
/* Service-area Leaflet map container needs a deterministic height before
   Leaflet initializes; otherwise it computes tiles against a 0-px
   container and the rendered map ends up as a few stray tiles in a tall
   empty box once the deferred stylesheet swaps in. */
.area-map{height:clamp(360px,50vh,540px);border-radius:14px;overflow:hidden;position:relative;z-index:0;background:#F1F4FA}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:0s!important;transition-duration:0s!important;animation-iteration-count:1!important}}
</style>
