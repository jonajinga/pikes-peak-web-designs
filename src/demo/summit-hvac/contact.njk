          <h3 style="margin:0 0 0.5rem;font-size:1.5rem">Estimate request</h3>
          <p style="margin:0 0 1.5rem;color:var(--su-text-muted);font-size:0.95rem">Fields marked * are required. Everything else helps us scope faster.</p>

          <div class="summit-form-row">
            <div>
              <label for="name">Full name *</label>
              <input type="text" id="name" name="name" required autocomplete="name">
            </div>
            <div>
              <label for="phone">Phone *</label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel">
            </div>
          </div>

          <div>
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email">
          </div>

          <div class="summit-form-row">
            <div>
              <label for="address">Property address *</label>
              <input type="text" id="address" name="address" required>
            </div>
            <div>
              <label for="sqft">Sq ft (approx)</label>
              <input type="text" id="sqft" name="sqft" placeholder="e.g. 2100">
            </div>
          </div>

          <div class="summit-form-row">
            <div>
              <label for="year">Year built</label>
              <input type="text" id="year" name="year" placeholder="e.g. 1952">
            </div>
            <div>
              <label for="project">Project type *</label>
              <select id="project" name="project" required>
                <option value="">Select…</option>
                <option>Heat pump (replace furnace + AC)</option>
                <option>AC replacement only</option>
                <option>Furnace replacement only</option>
                <option>Ductless mini-split</option>
                <option>Indoor air quality (filter / humidifier / ERV)</option>
                <option>Service / repair existing system</option>
                <option>Not sure, need assessment</option>
              </select>
            </div>
          </div>

          <div>
            <label for="current">Current system (if known)</label>
            <input type="text" id="current" name="current" placeholder="e.g. 2010 Lennox 80% furnace + 3-ton Carrier AC">
          </div>

          <div>
            <label for="notes">Anything else?</label>
            <textarea id="notes" name="notes" rows="4" placeholder="Unusual layout, known duct issues, timing constraints, specific equipment you want us to quote, etc."></textarea>
          </div>

          <button type="submit" class="summit-btn" style="justify-content:center;width:100%">Submit estimate request</button>
          <p style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--su-text-muted);text-align:center;margin:0.75rem 0 0">1 business day response &middot; Denver metro only</p>
