        <div style="font-family:'Space Grotesk',sans-serif;font-size:1.18rem;font-weight:700;letter-spacing:-0.01em;margin-bottom:0.5rem">Cyan deep</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:0.82rem;opacity:0.95">#0369A1</div>
        <div style="font-size:0.85rem;opacity:0.92;margin-top:0.5rem">Primary action button, link color on light</div>
      </div>
