        <div style="font-family:'Space Grotesk',sans-serif;font-size:1.18rem;font-weight:700;letter-spacing:-0.01em;margin-bottom:0.5rem">Navy</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:0.82rem;opacity:0.95">#0C4A6E</div>
        <div style="font-size:0.85rem;opacity:0.92;margin-top:0.5rem">Headings, dark surfaces</div>
      </div>
      <div style="background:#082F49;color:#E0F2FE;padding:1.5rem;border-radius:6px">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:1.18rem;font-weight:700;letter-spacing:-0.01em;margin-bottom:0.5rem">Navy deep</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:0.82rem;opacity:0.95">#082F49</div>
