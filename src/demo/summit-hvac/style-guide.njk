        <div style="font-family:'JetBrains Mono',monospace;font-size:0.82rem;opacity:0.95">#0EA5E9</div>
        <div style="font-size:0.85rem;opacity:0.92;margin-top:0.5rem">Accent, links on dark, blueprint highlights</div>
      </div>
