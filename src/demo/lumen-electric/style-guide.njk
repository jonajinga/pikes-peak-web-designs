<section class="lumen-section lumen-section--black">
  <div class="lumen-container">
    <div style="font-family:'Archivo',sans-serif;font-weight:700;font-size:0.78rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--lu-yellow);margin-bottom:0.85rem;padding-bottom:0.55rem;border-bottom:3px solid var(--lu-yellow);display:inline-block">02 / Typography</div>
    <h2 style="font-family:'Archivo Black',sans-serif;font-weight:400;font-size:clamp(2rem,1.5rem+1.5vw,3.25rem);letter-spacing:-0.02em;text-transform:uppercase;color:#FFFFFF;line-height:1.0;margin:0.5rem 0 0.75rem">Two faces. <em style="background:var(--lu-yellow);padding:0 0.1em;color:var(--lu-black)">Both Archivo.</em></h2>
    <p style="max-width:62ch;color:rgba(255,255,255,0.85);margin:0 0 2rem;font-size:1.05rem">Archivo Black for the headlines. Archivo (variable) for everything else. No serifs anywhere on the system. No third typeface.</p>

