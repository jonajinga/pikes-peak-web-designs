          <div style="padding:0.85rem 1rem;border-left:3px solid var(--rc-red);background:var(--demo-cream);border-radius:0 4px 4px 0"><strong style="color:var(--rc-text);font-size:0.95rem">Cimarron Hills</strong><br><span style="color:var(--rc-text-muted);font-size:0.82rem">80915</span></div>
          <div style="padding:0.85rem 1rem;border-left:3px solid var(--rc-red);background:var(--demo-cream);border-radius:0 4px 4px 0"><strong style="color:var(--rc-text);font-size:0.95rem">Falcon</strong><br><span style="color:var(--rc-text-muted);font-size:0.82rem">80831</span></div>
          <div style="padding:0.85rem 1rem;border-left:3px solid var(--rc-red);background:var(--demo-cream);border-radius:0 4px 4px 0"><strong style="color:var(--rc-text);font-size:0.95rem">Woodland Park</strong><br><span style="color:var(--rc-text-muted);font-size:0.82rem">80863</span></div>
