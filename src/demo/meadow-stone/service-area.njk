---

<section class="meadow-section meadow-section--terra">
  <div class="meadow-container">
    <nav style="font-size:0.85rem;color:var(--me-text-muted);margin-bottom:1rem">
      <a href="/demo/meadow-stone/" style="color:var(--me-terracotta)">Home</a> &nbsp;/&nbsp; <span>Service Area</span>
    </nav>
    <span class="meadow-eyebrow">Coverage</span>
    <h1 style="font-family:var(--me-font-display);font-size:clamp(2rem,1.4rem+2.5vw,3.25rem);color:var(--me-charcoal);font-weight:400;line-height:1.1;margin:0.5rem 0 1.25rem;font-style:italic">Working the land <em style="color:var(--me-terracotta-deep);font-style:italic">across Boulder County.</em></h1>
    <p style="font-family:var(--me-font-body);font-size:1.05rem;line-height:1.7;color:var(--me-text);max-width:62ch">Most of our installs are inside a thirty-mile loop, Boulder out to Niwot and Erie, north to Longmont and Lyons, south to Louisville and Lafayette. Click any pin for the area's growing zone, soil notes, and what we plant most.</p>
  </div>
</section>

<section class="meadow-section">
  <div class="meadow-container">
    <div id="meadow-coverage-map" style="height:480px;border:1px solid var(--me-line);border-radius:var(--me-radius);box-shadow:0 12px 32px rgba(60,40,20,0.10)" role="region" aria-label="Map of Meadow &amp; Stone's Boulder County service area"></div>
    <p style="margin-top:1rem;font-size:0.82rem;color:var(--me-text-muted);text-align:center;font-style:italic">Map tiles &amp; data &copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener" style="color:var(--me-terracotta)">OpenStreetMap</a> contributors.</p>
  </div>
</section>

<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  (function () {
    var shop = { name: 'Meadow & Stone studio', lat: 40.0150, lng: -105.2705 };
    var areas = [
      { name: 'Boulder',     zips: '80301–80305', lat: 40.0150, lng: -105.2705, zone: 'Zone 5b' },
      { name: 'Niwot',       zips: '80544',        lat: 40.0989, lng: -105.1714, zone: 'Zone 5b' },
      { name: 'Lyons',       zips: '80540',        lat: 40.2247, lng: -105.2719, zone: 'Zone 5a' },
      { name: 'Louisville',  zips: '80027',        lat: 39.9778, lng: -105.1319, zone: 'Zone 5b' },
      { name: 'Lafayette',   zips: '80026',        lat: 39.9936, lng: -105.0897, zone: 'Zone 5b' },
      { name: 'Erie',        zips: '80516',        lat: 40.0503, lng: -105.0494, zone: 'Zone 5b' },
      { name: 'Longmont',    zips: '80501–80504', lat: 40.1672, lng: -105.1019, zone: 'Zone 5b' },
      { name: 'Superior',    zips: '80027',        lat: 39.9528, lng: -105.1686, zone: 'Zone 5b' },
      { name: 'Eldorado Spr.', zips: '80025',      lat: 39.9320, lng: -105.2780, zone: 'Zone 5a' },
      { name: 'Gunbarrel',   zips: '80301',        lat: 40.0680, lng: -105.1680, zone: 'Zone 5b' }
    ];

    function init() {
      if (typeof L === 'undefined') return;
      var el = document.getElementById('meadow-coverage-map');
      if (!el) return;
      var map = L.map(el, { center: [shop.lat, shop.lng], zoom: 10, scrollWheelZoom: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
        maxZoom: 18
      }).addTo(map);

      var shopIcon = L.divIcon({
        className: 'me-shop-marker',
        html: '<span style="display:block;width:22px;height:22px;border-radius:50%;background:#A8412B;border:3px solid #F5EFE3;box-shadow:0 0 0 2px #A8412B"></span>',
        iconSize: [22, 22], iconAnchor: [11, 11]
      });
      L.marker([shop.lat, shop.lng], { icon: shopIcon }).addTo(map)
        .bindPopup('<strong>Meadow &amp; Stone</strong><br>Studio in central Boulder');

      var markers = [];
      areas.forEach(function (a) {
        var m = L.marker([a.lat, a.lng]).addTo(map);
        m.bindPopup('<strong>' + a.name + '</strong><br>Zip: ' + a.zips + '<br><em>' + a.zone + '</em>');
        markers.push(m);
      });

      L.circle([shop.lat, shop.lng], { radius: 38000, color: '#A8412B', weight: 1.2, fillOpacity: 0.05, dashArray: '5,7' })
        .addTo(map).bindTooltip('Standard install radius (~24 mi)');

      var group = L.featureGroup(markers.concat([L.marker([shop.lat, shop.lng])]));
      map.fitBounds(group.getBounds().pad(0.18));
      map.on('click', function () { map.scrollWheelZoom.enable(); });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);
  })();
</script>

<section class="meadow-section meadow-section--terra">
  <div class="meadow-container">
    <span class="meadow-eyebrow">What grows here</span>
    <h2 style="font-family:var(--me-font-display);font-size:clamp(1.6rem,1.2rem+1.4vw,2.3rem);color:var(--me-charcoal);font-weight:400;font-style:italic;margin:0.5rem 0 1rem">A short growing season. A long list of plants that thrive in it.</h2>
    <p style="font-family:var(--me-font-body);font-size:1rem;line-height:1.7;color:var(--me-text);max-width:65ch;margin-bottom:2rem">Boulder County sits in USDA hardiness zones 5a–5b. Mild for the elevation, dry by anyone's standard, and shaped by intense afternoon sun. The plant palette below thrives without irrigation theatrics.</p>

    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:1.5rem">
      <div style="padding:1.75rem;background:#FFFFFF;border:1px solid var(--me-line);border-radius:var(--me-radius)">
        <h3 style="font-family:var(--me-font-display);font-size:1.15rem;color:var(--me-charcoal);font-weight:600;margin-bottom:0.65rem">Native &amp; xeric</h3>
        <p style="font-family:var(--me-font-body);font-size:0.92rem;color:var(--me-text-muted);line-height:1.65;margin:0">Blue grama, little bluestem, blanketflower, penstemon, prairie smoke, rabbitbrush, mountain mahogany. Plant once, water for the first season, walk away.</p>
      </div>
      <div style="padding:1.75rem;background:#FFFFFF;border:1px solid var(--me-line);border-radius:var(--me-radius)">
        <h3 style="font-family:var(--me-font-display);font-size:1.15rem;color:var(--me-charcoal);font-weight:600;margin-bottom:0.65rem">Adapted ornamentals</h3>
        <p style="font-family:var(--me-font-body);font-size:0.92rem;color:var(--me-text-muted);line-height:1.65;margin:0">Russian sage, catmint, lavender, salvia, yarrow, hyssop, sedum. Heat-tolerant, deer-resistant, in flower from May through frost.</p>
      </div>
      <div style="padding:1.75rem;background:#FFFFFF;border:1px solid var(--me-line);border-radius:var(--me-radius)">
        <h3 style="font-family:var(--me-font-display);font-size:1.15rem;color:var(--me-charcoal);font-weight:600;margin-bottom:0.65rem">Stone &amp; structure</h3>
        <p style="font-family:var(--me-font-body);font-size:0.92rem;color:var(--me-text-muted);line-height:1.65;margin:0">Lyons sandstone, Boulder buff sandstone, native fieldstone walls, gravel paths, dry creek beds. Hardscape that ages well in this climate, sourced locally.</p>
      </div>
    </div>
  </div>
</section>

<section class="meadow-cta">
  <div class="meadow-container" style="text-align:center;padding-block:clamp(3rem,6vw,5rem)">
    <h2 style="font-family:var(--me-font-display);font-size:clamp(1.5rem,1.2rem+1.2vw,2.2rem);color:#FFFFFF;font-weight:400;font-style:italic;margin-bottom:0.85rem">Visiting properties this week.</h2>
    <p style="color:rgba(255,255,255,0.85);font-size:1rem;margin-bottom:1.75rem">Initial site visits are free. Most designs land in 2&ndash;3 weeks; install windows depend on season.</p>
