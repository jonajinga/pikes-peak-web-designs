<section class="alpine-section">
  <div class="alpine-container">
    <div id="alpine-coverage-map" style="height:480px;border:1px solid var(--al-line);border-radius:var(--al-radius);box-shadow:0 8px 24px rgba(20,32,52,0.08)" role="region" aria-label="Map of Alpine Inspectors' Denver-metro service area"></div>
    <p style="margin-top:1rem;font-size:0.82rem;color:var(--al-text-muted);text-align:center">Map tiles &amp; data &copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener" style="color:var(--al-ink)">OpenStreetMap</a> contributors.</p>
  </div>
</section>

<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  (function () {
    var shop = { name: 'Alpine Inspectors office', lat: 39.7392, lng: -104.9903 };
    var areas = [
      { name: 'Denver',           zips: '80201–80299', lat: 39.7392, lng: -104.9903 },
      { name: 'Boulder',          zips: '80301–80310', lat: 40.0150, lng: -105.2705 },
      { name: 'Lakewood',         zips: '80214–80235', lat: 39.7047, lng: -105.0814 },
      { name: 'Aurora',           zips: '80010–80019', lat: 39.7294, lng: -104.8319 },
      { name: 'Centennial',       zips: '80111, 80112', lat: 39.5807, lng: -104.8772 },
      { name: 'Golden',           zips: '80401, 80403', lat: 39.7555, lng: -105.2211 },
      { name: 'Arvada',           zips: '80002, 80003', lat: 39.8028, lng: -105.0875 },
      { name: 'Westminster',      zips: '80030–80031', lat: 39.8367, lng: -105.0372 },
      { name: 'Thornton',         zips: '80229, 80233', lat: 39.8681, lng: -104.9719 },
      { name: 'Highlands Ranch',  zips: '80126, 80129', lat: 39.5538, lng: -104.9692 },
      { name: 'Parker',           zips: '80134, 80138', lat: 39.5186, lng: -104.7614 },
      { name: 'Castle Rock',      zips: '80104, 80108', lat: 39.3722, lng: -104.8561 },
      { name: 'Longmont',         zips: '80501–80504', lat: 40.1672, lng: -105.1019 },
      { name: 'Evergreen',        zips: '80439',        lat: 39.6333, lng: -105.3172 }
    ];

    function init() {
      if (typeof L === 'undefined') return;
      var el = document.getElementById('alpine-coverage-map');
      if (!el) return;
      var map = L.map(el, { center: [shop.lat, shop.lng], zoom: 9, scrollWheelZoom: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
        maxZoom: 18
      }).addTo(map);

      var officeIcon = L.divIcon({
        className: 'alpine-office-marker',
        html: '<span style="display:block;width:22px;height:22px;border-radius:50%;background:#3b5a7a;border:3px solid #FAF6EE;box-shadow:0 0 0 2px #3b5a7a"></span>',
        iconSize: [22, 22], iconAnchor: [11, 11]
      });
      L.marker([shop.lat, shop.lng], { icon: officeIcon }).addTo(map)
        .bindPopup('<strong>Alpine Inspectors</strong><br>Central Denver office');

      var markers = [];
      areas.forEach(function (a) {
        var m = L.marker([a.lat, a.lng]).addTo(map);
        m.bindPopup('<strong>' + a.name + '</strong><br>Zip: ' + a.zips);
        markers.push(m);
      });

      L.circle([shop.lat, shop.lng], { radius: 56000, color: '#3b5a7a', weight: 1.2, fillOpacity: 0.05, dashArray: '5,7' })
        .addTo(map).bindTooltip('Standard service radius (~35 mi)');

      var group = L.featureGroup(markers.concat([L.marker([shop.lat, shop.lng])]));
      map.fitBounds(group.getBounds().pad(0.18));
      map.on('click', function () { map.scrollWheelZoom.enable(); });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);
  })();
</script>

<section class="alpine-section alpine-section--cream">
  <div class="alpine-container">
    <span class="alpine-eyebrow">What we see in this market</span>
    <h2 class="alpine-h2">Building stock varies by neighborhood. Inspections do too.</h2>
    <p style="font-size:1rem;line-height:1.65;max-width:65ch;margin:1rem 0 2rem">The Denver metro is geographically large and historically layered. We adapt the inspection scope based on what was built when, and what's known to fail in each area. Three patterns we see most:</p>

    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:1.5rem">
      <div style="padding:1.5rem;background:#FFFFFF;border:1px solid var(--al-line);border-radius:var(--al-radius)">
        <h3 style="font-family:var(--al-font-display);font-size:1.1rem;color:var(--al-ink);margin-bottom:0.65rem">Pre-1970 Denver core</h3>
        <p style="font-size:0.92rem;color:var(--al-text-muted);line-height:1.6;margin:0">Knob-and-tube wiring, cast-iron drains, asbestos in basements, original galvanized supply lines. Older homes need patient inspections; we plan two extra hours.</p>
      </div>
      <div style="padding:1.5rem;background:#FFFFFF;border:1px solid var(--al-line);border-radius:var(--al-radius)">
        <h3 style="font-family:var(--al-font-display);font-size:1.1rem;color:var(--al-ink);margin-bottom:0.65rem">1990s–2000s suburb boom</h3>
        <p style="font-size:0.92rem;color:var(--al-text-muted);line-height:1.6;margin:0">Highlands Ranch, Centennial, Parker, Aurora. Polybutylene plumbing in some, undersized panels in others. Fast-built construction with consistent issues.</p>
      </div>
      <div style="padding:1.5rem;background:#FFFFFF;border:1px solid var(--al-line);border-radius:var(--al-radius)">
        <h3 style="font-family:var(--al-font-display);font-size:1.1rem;color:var(--al-ink);margin-bottom:0.65rem">2010+ infill &amp; new builds</h3>
        <p style="font-size:0.92rem;color:var(--al-text-muted);line-height:1.6;margin:0">RiNo, Sloan's Lake, Stapleton/Central Park. Modern systems, but rushed punch-lists. We check what the builder closed up.</p>
      </div>
    </div>
  </div>
</section>

