              <option value="custom-calculator">Custom calculator built from scratch</option>
              <option value="booking-integration">Third-party booking integration (Calendly, Acuity, etc.)</option>
              <option value="email-template">Email-marketing template</option>
              <option value="migration">Migration from another platform (WordPress, Wix, etc.)</option>
              <option value="bespoke-page">Bespoke interactive or specialty page</option>
              <option value="trade-software">Integration with trade-specific software</option>
              <option value="other">Something else</option>
            </select>
          </div>

          <div class="form-group">
            <label for="hourlyDescription">Describe what you need <span class="req">*</span></label>
            <textarea id="hourlyDescription" name="description" placeholder="Plain language is fine. What it does, who it is for, any examples on other sites you have in mind, anything technical I should know up front." required rows="6"></textarea>
          </div>

          <div class="form-group">
            <label for="hourlyTimeline">Approximate timeline</label>
            <select id="hourlyTimeline" name="timeline">
              <option value="">Choose one&hellip;</option>
              <option value="asap">As soon as possible</option>
              <option value="2-weeks">Within two weeks</option>
              <option value="this-month">This month</option>
              <option value="next-month">Next month</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>

          <div id="form-error" role="alert" class="form-error">
            Something went wrong. Please try again or email me directly at <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
