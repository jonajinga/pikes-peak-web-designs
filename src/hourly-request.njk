      <div class="contact-form-card" id="request-form">
        <h2 class="form-heading">Describe what you need</h2>
        <p class="form-intro">Fill in a few fields, and I'll reply with a written estimate.</p>

        <form id="hourlyForm" data-web3forms data-redirect="/thank-you/?type=hourly-request" action="https://api.web3forms.com/submit" method="POST" class="form">
          <input type="hidden" name="access_key" value="b6c3454b-f07c-43f7-9070-0e0cb5286f55">
          <input type="hidden" name="subject" value="New hourly-work request, Pikes Peak Web Designs">
          <input type="hidden" name="from_name" value="Pikes Peak Web Designs">
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

          <div class="form-group">
            <label for="hourlyName">Your name <span class="req">*</span></label>
            <input type="text" id="hourlyName" name="name" placeholder="Jane Smith" required autocomplete="name">
          </div>

          <div class="form-group">
            <label for="hourlyEmail">Email <span class="req">*</span></label>
            <input type="email" id="hourlyEmail" name="email" placeholder="jane@example.com" required autocomplete="email">
          </div>

          <div class="form-group">
            <label for="hourlyBusiness">Business name</label>
            <input type="text" id="hourlyBusiness" name="business" placeholder="Smith Roofing LLC" autocomplete="organization">
          </div>

          <div class="form-group">
            <label for="hourlySite">Website address</label>
            <input type="url" id="hourlySite" name="site_url" placeholder="https://yoursite.com" inputmode="url" autocomplete="url">
          </div>

          <div class="form-group">
            <label for="hourlyClient">Are you an existing client? <span class="req">*</span></label>
            <select id="hourlyClient" name="existing_client" required>
              <option value="">Choose one&hellip;</option>
              <option value="yes">Yes, I'm on the $175-a-month plan</option>
              <option value="no">No, this would be a one-off job</option>
            </select>
          </div>

          <div class="form-group">
            <label for="hourlyType">What kind of work? <span class="req">*</span></label>
            <select id="hourlyType" name="work_type" required>
              <option value="">Choose one&hellip;</option>
              <option value="custom-calculator">A custom calculator</option>
              <option value="booking-integration">A booking system from another company (Calendly, Acuity, and others)</option>
              <option value="email-template">An email-marketing template</option>
              <option value="migration">A move from another website platform</option>
              <option value="bespoke-page">A custom interactive or specialty page</option>
              <option value="trade-software">A connection to your trade software</option>
              <option value="other">Something else</option>
            </select>
          </div>

          <div class="form-group">
            <label for="hourlyDescription">Describe what you need <span class="req">*</span></label>
            <textarea id="hourlyDescription" name="description" placeholder="Plain language is fine. What it should do, who it's for, examples from other sites, and anything technical I should know." required rows="6"></textarea>
          </div>

          <div class="form-group">
            <label for="hourlyTimeline">Approximate timeline</label>
            <select id="hourlyTimeline" name="timeline">
              <option value="">Choose one&hellip;</option>
              <option value="asap">As soon as possible</option>
              <option value="2-weeks">Within two weeks</option>
              <option value="this-month">This month</option>
              <option value="next-month">Next month</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>

          <div id="form-error" role="alert" class="form-error">
            Something went wrong. Please try again, or email me directly at <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
          </div>

          <button type="submit" class="btn btn-primary btn-full btn-lg">Request a written estimate</button>
          <p class="form-hint">You pay nothing in advance. The written estimate comes first, with the hours and what you'll get spelled out.</p>
        </form>
