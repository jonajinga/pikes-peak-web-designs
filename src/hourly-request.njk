            <label for="hourlySite">Site URL</label>
            <input type="url" id="hourlySite" name="site_url" placeholder="https://yoursite.com" inputmode="url" autocomplete="url">
          </div>

          <div class="form-group">
            <label for="hourlyClient">Are you an existing client? <span class="req">*</span></label>
            <select id="hourlyClient" name="existing_client" required>
              <option value="">Choose one&hellip;</option>
              <option value="yes">Yes, on the standard $175/month plan</option>
              <option value="no">Not yet, this would be a one-off engagement</option>
            </select>
          </div>

          <div class="form-group">
            <label for="hourlyType">What kind of work? <span class="req">*</span></label>
            <select id="hourlyType" name="work_type" required>
