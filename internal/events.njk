---
layout: layouts/base.njk
title: "Marketing Calendar | Pikes Peak Web Designs"
description: "Private operational dashboard. Networking, speaking, podcasts, pitch waves, and outreach campaigns Jon runs to bring new clients in."
noindex: true
eleventyExcludeFromCollections: true
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><span>Marketing calendar</span>
    </nav>
    <span class="section-label">Internal &middot; for Jon</span>
    <h1>Marketing <em>calendar.</em></h1>
    <p>This is the private operational dashboard. Every networking event, podcast, speaking gig, pitch wave, and outreach campaign that brings new clients in lives here. Edit <code>src/_data/events.js</code> to add or update an entry; the page re-renders on every build.</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:980px">

    {% set upcoming = [] %}
    {% set thisWeek = [] %}
    {% set inPrep = [] %}
    {% set ideas = [] %}
    {% set completed = [] %}
    {% set declined = [] %}

    {% for e in events.events %}
      {% if e.status == "completed" %}
        {% set completed = (completed.push(e), completed) %}
      {% elif e.status == "declined" %}
        {% set declined = (declined.push(e), declined) %}
      {% elif e.status == "idea" %}
        {% set ideas = (ideas.push(e), ideas) %}
      {% elif e.status == "prep" %}
        {% set inPrep = (inPrep.push(e), inPrep) %}
      {% else %}
        {% set upcoming = (upcoming.push(e), upcoming) %}
      {% endif %}
    {% endfor %}

    {# At-a-glance summary strip #}
    <div class="events-summary">
      <div class="events-summary-cell">
        <span class="events-summary-num">{{ upcoming.length + inPrep.length }}</span>
        <span class="events-summary-label">Active or upcoming</span>
      </div>
      <div class="events-summary-cell">
        <span class="events-summary-num">{{ inPrep.length }}</span>
        <span class="events-summary-label">In prep right now</span>
      </div>
      <div class="events-summary-cell">
        <span class="events-summary-num">{{ ideas.length }}</span>
        <span class="events-summary-label">In the backlog</span>
      </div>
      <div class="events-summary-cell">
        <span class="events-summary-num">{{ completed.length }}</span>
        <span class="events-summary-label">Recently completed</span>
      </div>
    </div>

    {# In-prep section: things that need attention #}
    {% if inPrep.length > 0 %}
    <h2 class="events-h">In prep — needs attention</h2>
    <ul class="events-list">
      {% for e in inPrep %}
        {% include "partials/event-card.njk" %}
      {% endfor %}
    </ul>
    {% endif %}

    {# Upcoming: scheduled, sorted by date #}
    {% if upcoming.length > 0 %}
    <h2 class="events-h">Upcoming</h2>
    <ul class="events-list">
      {% for e in upcoming | sort(false, false, "date") %}
        {% include "partials/event-card.njk" %}
      {% endfor %}
    </ul>
    {% endif %}

    {# Completed: most recent first #}
    {% if completed.length > 0 %}
    <h2 class="events-h">Recently completed</h2>
    <ul class="events-list events-list--past">
      {% for e in completed | reverse %}
        {% include "partials/event-card.njk" %}
      {% endfor %}
    </ul>
    {% endif %}

    {# Declined: kept for the rejection log + re-pitch reminders #}
    {% if declined.length > 0 %}
    <h2 class="events-h">Declined / passed</h2>
    <ul class="events-list events-list--past">
      {% for e in declined %}
        {% include "partials/event-card.njk" %}
      {% endfor %}
    </ul>
    {% endif %}

    {# Backlog / ideas: things without confirmed dates #}
    {% if ideas.length > 0 %}
    <h2 class="events-h">Backlog &amp; ideas</h2>
    <ul class="events-list events-list--ideas">
      {% for e in ideas %}
        {% include "partials/event-card.njk" %}
      {% endfor %}
    </ul>
    {% endif %}

    <div class="events-foot">
      <p><strong>To add an event:</strong> open <code>src/_data/events.js</code> and append an entry to the <code>events</code> array. The shape is documented at the top of the file.</p>
      <p><strong>To close one out:</strong> set <code>status: "completed"</code> (or <code>"declined"</code>), fill in <code>outcome</code> and <code>leads</code>, and the entry moves into the historical section automatically.</p>
    </div>
  </div>
</section>
