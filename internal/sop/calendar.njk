      <td>Active engagements</td>
    </tr>
    <tr>
      <td>Wednesday<br><em>9am&ndash;1:30pm</em></td>
      <td>0:30 inbox triage<br>1:00 maintenance pass across active client sites<br>2:00 content production (research / draft / edit)<br>0:30 client comms + shutdown</td>
